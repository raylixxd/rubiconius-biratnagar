---
import type { Commission } from '../data/site';
import '../styles/showcase.css';

interface Props {
  commission: Commission;
}

const { commission } = Astro.props;
const plates = commission.showcase ?? [];
---

{plates.length > 0 && (
  <section class="case-showcase" id="case-showcase" data-case-showcase aria-labelledby="showcase-heading" data-surface-stage>
    <div class="case-showcase__viewport" data-showcase-viewport>
      <div class="case-showcase__progress" aria-hidden="true">
        <div class="case-showcase__progress-bar" data-showcase-progress></div>
      </div>

      <div class="case-showcase__header wrap">
        <div class="case-showcase__hud">
          <div class="case-showcase__hud-left">
            <span class="showcase-hud__swatch" data-showcase-active-swatch aria-hidden="true"></span>
            <span class="section-kicker">Material Study &middot; Architectural Elevation</span>
          </div>
          <div class="case-showcase__hud-right">
            <span class="showcase-hud__counter" data-showcase-counter>01 / {String(plates.length).padStart(2, '0')}</span>
          </div>
        </div>
        <h2 id="showcase-heading" class="case-showcase__title">
          Measured Studies &middot; {commission.title}
        </h2>
      </div>

      <div class="case-showcase__track" data-showcase-track role="region" aria-label="Showcase architectural study plates">
        {plates.map((plate) => (
          <article
            class="showcase-plate"
            data-plate-id={plate.id}
            data-surface-theme={plate.surfaceTheme}
            data-swatch-hex={plate.swatchHex}
            role="button"
            tabindex="0"
            aria-label={`Inspect ${plate.index}: ${plate.title}`}
          >
            <div
              class="showcase-plate__media"
              data-showcase-gl
              data-plate-id={plate.id}
              data-crop-rect={JSON.stringify(plate.cropRect)}
              data-theme={plate.surfaceTheme}
              data-swatch={plate.swatchHex}
            >
              <img
                src={plate.image.src}
                alt={`${plate.title} - ${plate.caption}`}
                width={plate.image.width}
                height={plate.image.height}
                loading="eager"
                decoding="async"
              />
            </div>

            <div class="showcase-plate__meta" data-depth-front>
              <div class="showcase-plate__toprow">
                <span class="showcase-plate__annot">{plate.annotation}</span>
                <div class="showcase-plate__badge">
                  <span class="showcase-plate__swatch" style={`background-color: ${plate.swatchHex}`} aria-hidden="true"></span>
                  <span class="showcase-plate__idx">{plate.index}</span>
                </div>
              </div>
              <h3 class="showcase-plate__heading" data-magnetic-headline>{plate.title}</h3>
              <p class="showcase-plate__caption">{plate.caption}</p>
              <p class="showcase-plate__spec">{plate.materialSpec}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
