---
import { site } from '../data/site';
---
<div id="loader" role="status" aria-label="Loading studio">
  <div class="loader__mark" aria-hidden="true">
    <svg width="42" height="48" viewBox="0 0 120 140" fill="none">
      <path d="M36 16H84L104 92C89 83 75 78 60 78C45 78 31 83 16 92L36 16ZM60 40L44 74C50 72 55 71 60 71C65 71 70 72 76 74L60 40Z" fill="#1e1b1a" />
      <path d="M35 97C46 105 74 105 85 97C86 112 75 119 66 123C62 125 60 130 61 135C52 130 48 122 50 116C52 112 46 109 42 114C37 110 34 103 35 97Z" fill="#1e1b1a" />
    </svg>
  </div>
  <p class="loader__name otto-t12">
    <span class="otto-line"><span class="otto-line__in" data-loader-out>{site.name}</span></span>
  </p>
  <p class="loader__count otto-t12">
    <span class="otto-line"><span class="otto-line__in" data-loader-count data-loader-out>0%</span></span>
  </p>
</div>
