---
import { ClientRouter } from 'astro:transitions';
import Loader from '../components/Loader.astro';
import { commissions, site } from '../data/site';
import '../styles/tokens.css';
import '../styles/engine.css';
import '../styles/site.css';
import '../styles/showroom.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  immersive?: boolean;
  heroOverlay?: boolean;
}

const {
  title,
  description = site.description,
  image = '/og.jpg',
  immersive = false,
  heroOverlay = false,
} = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const previewOrigin = import.meta.env.PUBLIC_SITE_URL || (Astro.site ? Astro.site.origin : site.url);
const ogImage = new URL(image, previewOrigin).href;
const currentPath = Astro.url.pathname;
const htmlClasses = [
  immersive ? 'is-showroom' : undefined,
  heroOverlay ? 'has-hero-overlay' : undefined,
].filter(Boolean).join(' ') || undefined;

const primaryOffice = site.offices[0];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: site.name,
  founder: { '@type': 'Person', name: site.founder },
  description: site.description,
  url: site.url,
  telephone: site.phoneDisplay,
  openingHours: 'Su-Fr 11:00-17:00',
  sameAs: site.socials.map((s) => s.href),
  address: {
    '@type': 'PostalAddress',
    streetAddress: primaryOffice ? primaryOffice.address : site.city,
    addressLocality: primaryOffice ? primaryOffice.city : (site.primaryCity || 'Nepal'),
    addressCountry: 'NP',
  },
};
---
<!doctype html>
<html lang="en" class={htmlClasses} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#20201E" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preload" href="/fonts/boska-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/switzer-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/anton-400.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
      }
      (function syncVw() {
        var setVw = function () {
          document.documentElement.style.setProperty('--vw', document.documentElement.clientWidth + 'px');
        };
        setVw();
        window.addEventListener('resize', setVw, { passive: true });
        document.addEventListener('astro:page-load', setVw);
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="gl" transition:persist="gl" aria-hidden="true"></div>
    <div id="curtain" transition:persist="curtain" aria-hidden="true">
      <div class="curtain__blades">
        <span class="curtain__blade"></span>
        <span class="curtain__blade"></span>
        <span class="curtain__blade"></span>
        <span class="curtain__blade"></span>
      </div>
      <div class="curtain__crest">
        <svg width="28" height="34" viewBox="0 0 120 140" fill="none" aria-hidden="true">
          <path d="M36 16H84L104 92C89 83 75 78 60 78C45 78 31 83 16 92L36 16ZM60 40L44 74C50 72 55 71 60 71C65 71 70 72 76 74L60 40Z" fill="currentColor" />
          <path d="M35 97C46 105 74 105 85 97C86 112 75 119 66 123C62 125 60 130 61 135C52 130 48 122 50 116C52 112 46 109 42 114C37 110 34 103 35 97Z" fill="currentColor" />
        </svg>
        <span class="curtain__line"></span>
        <span class="curtain__word">{site.name}</span>
      </div>
    </div>
    <Loader />

    {!immersive && (
    heroOverlay ? (
      <header class="site-header site-header--hero otto-header" data-theme="dark" data-header-theme="dark">
        <div class="otto-header__row">
          <a class="otto-header__logo otto-abs" href="/" style="--x: 20; --y: 14" aria-label={`${site.name}, home`}>
            <svg width="20" height="24" viewBox="0 0 120 140" fill="none" aria-hidden="true">
              <path d="M36 16H84L104 92C89 83 75 78 60 78C45 78 31 83 16 92L36 16ZM60 40L44 74C50 72 55 71 60 71C65 71 70 72 76 74L60 40Z" fill="currentColor" />
              <path d="M35 97C46 105 74 105 85 97C86 112 75 119 66 123C62 125 60 130 61 135C52 130 48 122 50 116C52 112 46 109 42 114C37 110 34 103 35 97Z" fill="currentColor" />
            </svg>
          </a>
          <a class="otto-t12 otto-abs otto-header__word" href="/" style="--x: 48; --y: 18">{site.name.toLowerCase()}</a>

          <div class="otto-header__coord otto-abs otto-t12" style="--x: 256; --y: 18" data-otto-fold-group>
            <span class="otto-header__coord-primary">Biratnagar &middot; Dharan</span>
            <span class="otto-header__coord-sub">26.4678&deg; N, 87.2767&deg; E</span>
          </div>

          <p class="otto-header__title otto-t50" data-otto-header-title>Quiet Architecture</p>

          <a class="otto-t12 otto-abs otto-header__link" href="/works/" style="--x: 1082; --y: 18" data-text-reactive="roll">Works</a>
          <a class="otto-t12 otto-abs otto-header__link" href="/practice/" style="--x: 1146; --y: 18" data-text-reactive="roll">Practice</a>
          <a class="otto-t12 otto-abs otto-header__link" href="/showroom/" style="--x: 1218; --y: 18" data-text-reactive="roll">3D Study</a>
          <button class="sound-btn hero-sound-btn otto-abs" type="button" data-sound-toggle aria-pressed="false" aria-label="Toggle studio sound" style="--x: 1296; --y: 12">
            <span class="sound-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span class="sr-only" data-sound-label>Sound</span>
          </button>
          <button class="otto-t12 otto-abs otto-abs--r otto-header__cart" type="button" data-open-drawer style="--r: 1420; --y: 18">
            Inquire &#8599;
          </button>
          <button class="otto-t12 otto-phone-menu" type="button" data-menu-open aria-expanded="false" aria-controls="mobile-menu">
            Menu
          </button>
        </div>
      </header>
    ) : (
      <header class="site-header">
        <a class="brand-mark" href="/">
          <svg width="20" height="24" viewBox="0 0 120 140" fill="none" aria-hidden="true">
            <path d="M36 16H84L104 92C89 83 75 78 60 78C45 78 31 83 16 92L36 16ZM60 40L44 74C50 72 55 71 60 71C65 71 70 72 76 74L60 40Z" fill="currentColor" />
            <path d="M35 97C46 105 74 105 85 97C86 112 75 119 66 123C62 125 60 130 61 135C52 130 48 122 50 116C52 112 46 109 42 114C37 110 34 103 35 97Z" fill="currentColor" />
          </svg>
          <span>{site.name}</span>
        </a>

        <nav class="site-nav" aria-label="Primary navigation">
          <div class="site-nav__links">
            {site.nav.map((item) => (
              <a
                class="draw"
                href={item.href}
                data-text-reactive="roll"
                aria-current={currentPath === item.href || (item.href === '/works/' && currentPath.startsWith('/works')) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
          </div>

          <button class="sound-btn" type="button" data-sound-toggle aria-pressed="false" aria-label="Toggle studio sound">
            <span class="sound-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span class="sr-only" data-sound-label>Sound</span>
          </button>

          <button class="arch-link" type="button" data-open-drawer>
            <span>Inquire</span>
            <span aria-hidden="true">&#8599;</span>
          </button>

          <button class="menu-trigger" type="button" data-menu-open aria-expanded="false" aria-controls="mobile-menu">
            Menu
          </button>
        </nav>
      </header>
    )
    )}

    {!immersive && (
    <div id="mobile-menu" class="mobile-menu" role="dialog" aria-modal="true" aria-label="Site navigation" data-lenis-prevent hidden>
      <div class="mobile-menu__top">
        <span class="section-kicker mobile-menu__brand">{site.name}</span>
        <button class="mobile-menu__close" type="button" data-menu-close>Close</button>
      </div>
      <ul class="mobile-menu__list">
        {site.nav.map((item, idx) => (
          <li class="mobile-menu__item">
            <a
              class="mobile-menu__link"
              href={item.href}
              aria-current={currentPath === item.href || (item.href === '/works/' && currentPath.startsWith('/works')) ? 'page' : undefined}
            >
              <span class="mobile-menu__idx">{String(idx + 1).padStart(2, '0')}</span>
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="mobile-menu__foot">
        <button class="btn btn--accent mobile-menu__cta" type="button" data-fill data-open-drawer>
          <span class="btn__fill" aria-hidden="true"></span>
          <span>Private Inquiry</span>
          <span class="btn__arrow" aria-hidden="true">&rarr;</span>
        </button>
      </div>
    </div>
    )}

    <main id="main" tabindex="-1">
      <slot />
    </main>

    {!immersive && (
    <footer class="site-footer" data-theme-zone="dark">
      <div class="arch-grid-lines arch-grid-lines--dark" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>

      <div class="footer-grid wrap">
        <div class="footer-col footer-col--brand">
          <a class="footer-brand-mark" href="/" aria-label={`${site.name} Home`}>
            <svg width="24" height="28" viewBox="0 0 120 140" fill="none" aria-hidden="true">
              <path d="M36 16H84L104 92C89 83 75 78 60 78C45 78 31 83 16 92L36 16ZM60 40L44 74C50 72 55 71 60 71C65 71 70 72 76 74L60 40Z" fill="currentColor" />
              <path d="M35 97C46 105 74 105 85 97C86 112 75 119 66 123C62 125 60 130 61 135C52 130 48 122 50 116C52 112 46 109 42 114C37 110 34 103 35 97Z" fill="currentColor" />
            </svg>
          </a>
          <p class="footer-brand-name">{site.name}</p>
          <p class="footer-brand-loc">{site.city}</p>
        </div>

        <div class="footer-col">
          <h2 class="footer-col__title">Enquiries</h2>
          <ul class="footer-col__list">
            <li><a href={`tel:+${site.whatsappNumber}`}>{site.phoneDisplay}</a></li>
            <li><button type="button" data-open-drawer>Commission Brief</button></li>
            <li><a href={`https://wa.me/${site.whatsappNumber}`} target="_blank" rel="noopener noreferrer">Direct WhatsApp</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h2 class="footer-col__title">Spaces</h2>
          <ul class="footer-col__list">
            <li><a href="/works/">Selected Works</a></li>
            {commissions.slice(0, 2).map((c) => (
              <li><a href={`/works/${c.slug}/`}>{c.title}</a></li>
            ))}
            <li><a href="/showroom/">Material Study (3D)</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h2 class="footer-col__title">Practice</h2>
          <ul class="footer-col__list">
            <li><a href="/practice/">About {site.founder}</a></li>
            {site.offices.map((o) => (
              <li><a href="/practice/#studio-locator">{o.city} Studio</a></li>
            ))}
            {site.socials.slice(0, 1).map((s) => (
              <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
            ))}
          </ul>
        </div>

        <div class="footer-actions-panel">
          <a class="footer-preview-card" href="/showroom/">
            <img
              src="/images/hero-poster.webp"
              alt={`${site.name} 3D Material Room Preview`}
              width="640"
              height="360"
              loading="lazy"
            />
            <span class="footer-preview-card__overlay" aria-hidden="true"></span>
            <span class="footer-preview-card__label">
              <span class="footer-preview-card__play" aria-hidden="true">&#9654;</span>
              <span>Explore 3D Study</span>
            </span>
          </a>

          <div class="footer-btn-pair">
            <a class="footer-btn-outline" href="/works/">
              <span data-text-reactive="roll">Selected Works</span>
            </a>
            <button class="footer-btn-cta" type="button" data-open-drawer>
              <span data-text-reactive="roll">Enquire now</span>
            </button>
          </div>

          <button class="footer-copy-btn" type="button" data-copy-phone={site.phoneDisplay}>
            Copy Studio Number ({site.phoneDisplay})
          </button>
        </div>
      </div>

      <div class="footer-wordmark-wrap wrap">
        <svg
          class="footer-monument-svg"
          viewBox="0 0 1400 205"
          role="img"
          aria-label={site.name.toUpperCase()}
        >
          <text
            x="700"
            y="168"
            text-anchor="middle"
            fill="currentColor"
            font-family="Boska, Georgia, serif"
            font-size="186"
            letter-spacing="-6"
            textLength="1380"
            lengthAdjust="spacingAndGlyphs"
          >
            {site.name.toUpperCase()}
          </text>
        </svg>
      </div>

      <div class="footer-bottom wrap">
        <div class="footer-badges" aria-label="Practice highlights">
          <span class="footer-badge studio-clock" data-studio-clock>{(site.primaryCity || site.offices[0]?.city || 'STUDIO').toUpperCase()} &middot; NPT</span>
          <span class="footer-badge"><span class="footer-badge__mark" aria-hidden="true">+</span> {site.offices.map((o) => o.city.toUpperCase()).join(' & ') || 'NEPAL'}</span>
          <span class="footer-badge">TURNKEY INTERIORS</span>
          <span class="footer-badge">DIRECT STUDIO CONTACT</span>
        </div>

        <p class="footer-colophon">
          {site.name} Interior Architecture &middot; {site.city} &middot; {site.hours}.
        </p>

        <button class="footer-top-btn" type="button" data-back-to-top>
          Back to top &uarr;
        </button>
      </div>
    </footer>
    )}

    <div id="consult-drawer" class="drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-heading" hidden>
      <div class="drawer__backdrop" data-drawer-backdrop></div>
      <div class="drawer__panel" data-lenis-prevent>
        <div class="drawer__head">
          <div>
            <p class="section-kicker drawer__kicker">
              <span>Direct Studio Brief</span>
              <span aria-hidden="true">&middot;</span>
              <span class="drawer__clock studio-clock" data-studio-clock>{(site.primaryCity || site.offices[0]?.city || 'STUDIO').toUpperCase()} &middot; NPT</span>
            </p>
            <h2 id="drawer-heading" class="drawer__title">Private Residential &amp; Spatial Commissions &middot; {site.primaryCity || site.offices[0]?.city || 'Nepal'}</h2>
          </div>
          <button class="drawer__close" type="button" data-close-drawer>Close</button>
        </div>

        <form class="drawer__form" data-wa-form>
          <label class="field">
            <span>Service / Space</span>
            <select name="space">
              <option>Turnkey Home Interior</option>
              <option>Master Bedroom / Single Room</option>
              <option>Drawing &amp; Dining Room</option>
              <option>Office / Commercial Renovation</option>
              <option>Modular Carpentry, Ceiling &amp; Decor</option>
            </select>
          </label>
          <label class="field">
            <span>Location</span>
            <select name="city">
              {site.offices.map((o) => (
                <option>{o.city}</option>
              ))}
              <option>{site.primaryRegion || 'Nepal (Other)'}</option>
            </select>
          </label>
          <label class="field">
            <span>Project Scope</span>
            <select name="area">
              <option>Single Room / Focused Space</option>
              <option selected>2BHK / 3BHK Residence</option>
              <option>Full Independent Home / Villa</option>
              <option>Commercial / Office Space</option>
            </select>
          </label>
          <label class="field">
            <span>Target Timeline</span>
            <select name="timeline">
              <option>Immediate start</option>
              <option selected>Within 2 months</option>
              <option>Planning stage (3+ months)</option>
            </select>
          </label>
        </form>

        <div class="drawer__preview">
          <p class="section-kicker" style="margin-bottom: 0.35rem;">Ready WhatsApp Message</p>
          <p data-wa-preview></p>
        </div>

        <div class="drawer__cta-row">
          <a
            class="btn btn--accent"
            data-fill
            data-wa-send
            href={`https://wa.me/${site.whatsappNumber}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="btn__fill" aria-hidden="true"></span>
            <span>Open in WhatsApp ({site.phoneDisplay})</span>
            <span class="btn__arrow" aria-hidden="true">&#8599;</span>
          </a>
          <a class="draw" href={`tel:+${site.whatsappNumber}`} data-tel-copy={site.phoneDisplay} aria-live="polite">Or call {site.phoneDisplay}</a>
        </div>
      </div>
    </div>

    <script>
      import { start } from '../engine/astro';
      import { setupMotion } from '../motion/setup';
      start(setupMotion);
    </script>
  </body>
</html>
