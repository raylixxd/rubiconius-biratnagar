---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base
  title="Room Plan Not Found"
  description={`Return to ${site.name} architectural interior practice across ${site.city}.`}
>
  <section class="inner-hero wrap" style="min-height: 65svh; align-content: center; padding-block: 4rem;">
    <div style="display: grid; gap: 1.25rem; max-width: 65ch;">
      <p class="section-kicker">404 &middot; Uncatalogued Spatial Volume</p>
      <h1 class="inner-hero__title" style="font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1.1;">
        This room plan is not drafted in our portfolio.
      </h1>
      <p class="hero__lead" style="color: var(--c-muted); line-height: 1.6;">
        The requested architectural coordinate does not exist. Return to the main studio monograph to explore completed residences across {site.offices.map((o) => o.city).join(' & ')}.
      </p>

      <div style="display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: center; margin-top: 1rem;">
        <a class="btn btn--accent" href="/" data-fill>
          <span class="btn__fill" aria-hidden="true"></span>
          <span>Return to Studio Monograph</span>
          <span class="btn__arrow" aria-hidden="true">&#8599;</span>
        </a>
        <a class="arch-cta arch-cta--muted" href="/works/">
          <span>View Selected Works &rarr;</span>
        </a>
        <a class="arch-cta arch-cta--muted" href="/practice/">
          <span>About the Practice &rarr;</span>
        </a>
      </div>

      <div style="margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--c-line); display: flex; flex-wrap: wrap; gap: 1rem 2rem; font-family: var(--f-body); font-size: var(--t-xs); color: var(--c-subtle); letter-spacing: 0.06em; text-transform: uppercase;">
        <span>Direct Desk: <a href={`tel:+${site.whatsappNumber}`} style="color: var(--c-fg); font-weight: 500;">{site.phoneDisplay}</a></span>
        <span>{site.offices[0].city}: {site.offices[0].address}</span>
        <span>Hours: {site.hours}</span>
      </div>
    </div>
  </section>
</Base>
