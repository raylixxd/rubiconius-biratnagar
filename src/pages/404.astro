---
import Base from '../layouts/Base.astro';
---
<Base title="Room Not Found" description="Return to the Rubiconius Biratnagar and Dharan interior architecture showcase.">
  <section class="inner-hero wrap" style="min-height: 58svh; align-content: center;">
    <p class="section-kicker">404</p>
    <h1 class="inner-hero__title">This room plan is not drafted here.</h1>
    <p class="hero__lead">Step back into the main studio gallery to explore completed residences and executive interiors.</p>
    <div>
      <a class="btn btn--accent" href="/" data-fill>
        <span class="btn__fill" aria-hidden="true"></span>
        <span>Return to Studio</span>
        <span class="btn__arrow" aria-hidden="true">&#8599;</span>
      </a>
    </div>
  </section>
</Base>
