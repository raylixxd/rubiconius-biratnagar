---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ShowroomStage from '../components/ShowroomStage.astro';
import { commissions, craftPlate, parquetPlate, site } from '../data/site';
import studioJoinery from '../assets/studio-joinery.jpg';
import studioMarble from '../assets/studio-marble.webp';
import studioThreshold from '../assets/studio-threshold.jpg';
import studioWorkTerrace from '../assets/studio-work-terrace.jpg';

const galleryFrames = [
  {
    idx: '01',
    title: commissions[0].title,
    caption: 'Fluted Master Suite · Biratnagar (2024)',
    meta: 'Sal Timber Canopy · 6,400 × 5,200 mm',
    image: commissions[0].image,
    alt: commissions[0].alt,
  },
  {
    idx: '02',
    title: commissions[1].title,
    caption: 'Formal Drawing Room · Dharan (2023)',
    meta: 'Honed Veined Marble · 7,800 × 4,800 mm',
    image: commissions[1].image,
    alt: commissions[1].alt,
  },
  {
    idx: '03',
    title: 'Timber & Plaster Study',
    caption: 'Private Bedroom Wing · Foothills Axis',
    meta: 'Lime Plaster & Rafters · 5,600 × 4,400 mm',
    image: studioWorkTerrace,
    alt: 'Low-slung Sal timber bedstead beneath exposed ceiling rafters',
  },
  {
    idx: '04',
    title: commissions[2].title,
    caption: 'Heritage Panelled Gallery · Biratnagar (2024)',
    meta: 'Tongue-and-Groove Millwork · 5,400 × 4,200 mm',
    image: commissions[2].image,
    alt: commissions[2].alt,
  },
];

const lookbookDims = [
  'W 6,400 × D 5,200 × H 3,200 mm',
  'W 7,800 × D 4,800 × H 3,400 mm',
  'W 5,400 × D 4,200 × H 3,150 mm',
];

const collectionCards = [
  {
    num: '01',
    name: 'Fluted Suite',
    dims: 'Dimensions: W 6,400 × D 5,200 × H 3,200 mm',
    href: `/works/${commissions[0].slug}/`,
    label: 'Explore Suite',
    image: commissions[0].image,
    alt: commissions[0].alt,
    pos: '--x: 256; --y: 378; --w: 338; --h: 431',
  },
  {
    num: '02',
    name: 'Drawing Room',
    dims: 'Dimensions: W 7,800 × D 4,800 × H 3,400 mm',
    href: `/works/${commissions[1].slug}/`,
    label: 'Explore Salon',
    image: commissions[1].image,
    alt: commissions[1].alt,
    pos: '--x: 610; --y: 378; --w: 338; --h: 333',
  },
  {
    num: '03',
    name: 'Heritage Gallery',
    dims: 'Dimensions: W 5,400 × D 4,200 × H 3,150 mm',
    href: `/works/${commissions[2].slug}/`,
    label: 'Explore Gallery',
    image: commissions[2].image,
    alt: commissions[2].alt,
    pos: '--x: 964; --y: 378; --w: 456; --h: 582',
  },
];

const closeMaterials = [
  {
    id: 'Sal Timber',
    label: '(A) Seasoned Sal Timber',
    image: studioJoinery,
    alt: 'Vertical fluted Sal timber joinery paired with dark green veined stone in daylight',
  },
  {
    id: 'Kota Limestone',
    label: '(B) Honed Kota Limestone',
    image: parquetPlate.image,
    alt: parquetPlate.alt,
  },
  {
    id: 'Veined Marble',
    label: '(C) Veined Marble & Brass',
    image: studioMarble,
    alt: 'Honed natural veined marble slab with subtle mineral variation',
  },
];
---
<Base heroOverlay={true}>
  <!-- Act 1: Uncluttered Full-Bleed Architectural Hero + Velocity-Reactive WebGL Lens -->
  <section id="cover" class="otto-hero" data-theme-zone="dark" aria-label={`${site.name}, Quiet Architecture`}>
    <h1 class="sr-only">{site.name}, Measured Interior Architecture in Biratnagar &amp; Dharan</h1>
    <div class="otto-hero__stage" data-otto-hero-stage>
      <picture class="otto-hero__picture">
        <img
          class="otto-hero__img"
          src="/images/hero-poster.webp"
          width="2560"
          height="1440"
          alt="Rubiconius architectural salon in vertical fluted Sal timber, honed stone, and calibrated dusk cove illumination"
          fetchpriority="high"
          decoding="sync"
          data-critical
        />
      </picture>
      <canvas class="otto-hero__gl" data-otto-hero-gl aria-hidden="true"></canvas>
    </div>
    <div class="otto-hero__shade" data-otto-hero-shade aria-hidden="true"></div>

    <div class="otto-lab-label otto-t12" data-otto-lab-label style="right: calc(20 * var(--s)); justify-content: space-between;">
      <div style="display:flex; flex-wrap:wrap; align-items:center; gap:calc(14 * var(--s));">
        <button type="button" data-otto-film="0">(A) Fluted Glass</button>
        <button type="button" class="is-on" data-otto-film="1">(C) Daylight Caustics</button>
        <button type="button" data-otto-film="2">(D) Brass Grazing</button>
        <span class="otto-lab-label__gap" aria-hidden="true"></span>
        <a href="/showroom/">3D Spatial Study &rarr;</a>
      </div>
      <span class="otto-hero__coord-foot" style="position:static; mix-blend-mode:normal;">Scroll to explore &darr;</span>
    </div>
  </section>

  <!-- Act 2A: Asymmetric Architectural Thesis Spine -->
  <section id="arch-story" class="arch-story" data-theme-zone="light" aria-labelledby="arch-story-heading">
    <div class="wrap">
      <div class="arch-story__head">
        <span class="arch-story__kicker otto-t12">01 · Architectural Thesis</span>
        <h2 id="arch-story-heading" class="arch-story__title" data-text-reactive="words">
          Measured rooms shaped in timber, honed stone, and calm daylight.
        </h2>
      </div>

      <div class="arch-story__spread">
        <figure class="arch-story__plate-main" data-story-plate="0">
          <div class="arch-story__frame arch-story__frame--tall">
            <Image
              class="project-photo"
              src={commissions[0].image}
              alt={commissions[0].alt}
              width={commissions[0].image.width}
              height={commissions[0].image.height}
              loading="eager"
              decoding="async"
            />
          </div>
          <figcaption class="arch-story__caption otto-t12s">
            <span>Plate 01 · {commissions[0].title}</span>
            <span>{commissions[0].location} · {commissions[0].year}</span>
          </figcaption>
        </figure>

        <figure class="arch-story__plate-aside" data-story-plate="1">
          <div class="arch-story__frame arch-story__frame--wide">
            <Image
              class="project-photo"
              src={studioThreshold}
              alt="Sunlight tracing across twin fluted timber portals and a monolithic travertine plinth"
              width={studioThreshold.width}
              height={studioThreshold.height}
              loading="eager"
              decoding="async"
            />
          </div>
          <figcaption class="arch-story__caption otto-t12s">
            <span>Study 02 · Mineral Plinth &amp; Portals</span>
            <span>Raking Daylight Datum</span>
          </figcaption>
        </figure>

        <dl class="arch-story__specs otto-t12s">
          <div class="arch-story__spec">
            <dt>Primary Bay Span</dt>
            <dd>W 6,400 mm</dd>
          </div>
          <div class="arch-story__spec">
            <dt>Joinery Relief</dt>
            <dd>24 mm Sal Battens</dd>
          </div>
          <div class="arch-story__spec">
            <dt>Lighting Kelvin</dt>
            <dd>2700K Perimeter Cove</dd>
          </div>
          <div class="arch-story__spec">
            <dt>Ceiling Clear Height</dt>
            <dd>H 3,200 mm</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Act 2B: Pure Borderless 3-Step Vector Architectural Elevation Morph -->
  <section class="otto-spin-stage" data-otto-spin-stage data-theme-zone="light" aria-label="Three structural stages of Rubiconius elevation">
    <div class="otto-forms" aria-live="polite">
      <ol class="otto-forms__steps otto-t12" aria-label="Architectural elevation in three chapters">
        <li class="otto-forms__n otto-abs" style="--x: 20">
          <span class="otto-line"><span class="otto-line__in" data-otto-step-num>01</span></span>
        </li>
        <li class="otto-forms__step is-active otto-abs" style="--x: 256" data-otto-step="0">
          <span class="otto-line"><span class="otto-line__in">Raw Proportion</span></span>
        </li>
        <li class="otto-forms__step otto-abs" style="--x: 1082" data-otto-step="1">
          <span class="otto-line"><span class="otto-line__in">Fluted Millwork</span></span>
        </li>
        <li class="otto-forms__step otto-abs otto-abs--r" style="--r: 1420" data-otto-step="2">
          <span class="otto-line"><span class="otto-line__in">Daylight Volume</span></span>
        </li>
      </ol>

      <div class="otto-flight-stage" data-otto-flight>
        <div class="otto-flight-stage__inner" data-otto-flight-inner>
          <svg class="otto-flight-stage__svg" viewBox="0 0 800 540" fill="none" aria-hidden="true" data-otto-flight-svg>
            <!-- Step 0: Perimeter Structural Frame & Three Bay Centerlines -->
            <rect x="64" y="48" width="672" height="420" stroke="currentColor" stroke-width="1.2" pathLength="1" data-otto-path data-cad-step="0" />
            <rect x="82" y="66" width="636" height="384" stroke="currentColor" stroke-width="0.7" stroke-opacity="0.6" pathLength="1" data-otto-path data-cad-step="0" />
            <line x1="294" y1="66" x2="294" y2="450" stroke="currentColor" stroke-width="0.85" pathLength="1" data-otto-path data-cad-step="0" />
            <line x1="506" y1="66" x2="506" y2="450" stroke="currentColor" stroke-width="0.85" pathLength="1" data-otto-path data-cad-step="0" />
            <line x1="36" y1="468" x2="764" y2="468" stroke="currentColor" stroke-width="1" stroke-dasharray="6 4" pathLength="1" data-otto-path data-cad-step="0" />
            <line x1="82" y1="114" x2="718" y2="114" stroke="currentColor" stroke-width="0.7" stroke-opacity="0.45" pathLength="1" data-otto-path data-cad-step="0" />

            <!-- Step 1: Vertical Fluted Sal Millwork Battens & Headboard Plinth -->
            <line x1="104" y1="114" x2="104" y2="450" stroke="currentColor" stroke-width="0.7" pathLength="1" data-otto-path data-cad-step="1" />
            <line x1="126" y1="114" x2="126" y2="450" stroke="currentColor" stroke-width="0.7" pathLength="1" data-otto-path data-cad-step="1" />
            <line x1="148" y1="114" x2="148" y2="450" stroke="currentColor" stroke-width="0.7" pathLength="1" data-otto-path data-cad-step="1" />
            <line x1="170" y1="114" x2="170" y2="450" stroke="currentColor" stroke-width="0.7" pathLength="1" data-otto-path data-cad-step="1" />
            <line x1="192" y1="114" x2="192" y2="450" stroke="currentColor" stroke-width="0.7" pathLength="1" data-otto-path data-cad-step="1" />
            <line x1="214" y1="114" x2="214" y2="450" stroke="currentColor" stroke-width="0.7" pathLength="1" data-otto-path data-cad-step="1" />
            <line x1="236" y1="114" x2="236" y2="450" stroke="currentColor" stroke-width="0.7" pathLength="1" data-otto-path data-cad-step="1" />
            <line x1="258" y1="114" x2="258" y2="450" stroke="currentColor" stroke-width="0.7" pathLength="1" data-otto-path data-cad-step="1" />
            <line x1="318" y1="114" x2="318" y2="338" stroke="currentColor" stroke-width="0.7" pathLength="1" data-otto-path data-cad-step="1" />
            <line x1="340" y1="114" x2="340" y2="338" stroke="currentColor" stroke-width="0.7" pathLength="1" data-otto-path data-cad-step="1" />
            <line x1="362" y1="114" x2="362" y2="338" stroke="currentColor" stroke-width="0.7" pathLength="1" data-otto-path data-cad-step="1" />
            <line x1="440" y1="114" x2="440" y2="338" stroke="currentColor" stroke-width="0.7" pathLength="1" data-otto-path data-cad-step="1" />
            <line x1="462" y1="114" x2="462" y2="338" stroke="currentColor" stroke-width="0.7" pathLength="1" data-otto-path data-cad-step="1" />
            <line x1="484" y1="114" x2="484" y2="338" stroke="currentColor" stroke-width="0.7" pathLength="1" data-otto-path data-cad-step="1" />
            <rect x="294" y="338" width="212" height="112" stroke="currentColor" stroke-width="1.15" pathLength="1" data-otto-path data-cad-step="1" />

            <!-- Step 2: Daylight Transom Bay, Brass Luminaires & Dimension Callouts -->
            <rect x="526" y="88" width="172" height="342" stroke="#8A6A42" stroke-width="1.05" pathLength="1" data-otto-path data-cad-step="2" />
            <line x1="526" y1="176" x2="698" y2="176" stroke="#8A6A42" stroke-width="0.8" pathLength="1" data-otto-path data-cad-step="2" />
            <line x1="612" y1="88" x2="612" y2="430" stroke="#8A6A42" stroke-width="0.8" pathLength="1" data-otto-path data-cad-step="2" />
            <circle cx="294" cy="242" r="14" stroke="#8A6A42" stroke-width="1.2" pathLength="1" data-otto-path data-cad-step="2" />
            <circle cx="506" cy="242" r="14" stroke="#8A6A42" stroke-width="1.2" pathLength="1" data-otto-path data-cad-step="2" />
            <line x1="64" y1="504" x2="736" y2="504" stroke="currentColor" stroke-width="0.85" pathLength="1" data-otto-path data-cad-step="2" />
            <line x1="64" y1="494" x2="64" y2="514" stroke="currentColor" stroke-width="1" pathLength="1" data-otto-path data-cad-step="2" />
            <line x1="736" y1="494" x2="736" y2="514" stroke="currentColor" stroke-width="1" pathLength="1" data-otto-path data-cad-step="2" />
          </svg>
        </div>
        <p class="otto-flight-stage__cap otto-t12">Elevation 1:20 · 6,400 × 3,200 mm Bay Rhythm</p>
      </div>

      <p class="otto-forms__title" aria-live="off">
        <span class="otto-line is-active" data-otto-step-title="0"><span class="otto-line__in">Raw Proportion</span></span>
        <span class="otto-line" data-otto-step-title="1"><span class="otto-line__in">Fluted Millwork</span></span>
        <span class="otto-line" data-otto-step-title="2"><span class="otto-line__in">Daylight Volume</span></span>
      </p>
    </div>
  </section>

  <!-- Act 3: OTTO-Style Pinned Horizontal Gallery & 01-04 Scrub Ruler -->
  <section id="otto-gallery" class="otto-gallery" data-otto-gallery data-theme-zone="light" aria-label="Architectural Monograph Gallery">
    <div class="otto-gallery__viewport">
      <ol class="otto-gallery__track" data-gallery-track>
        {galleryFrames.map((item) => (
          <li class="otto-gallery__item" data-gallery-item data-caption={item.caption}>
            <div class="otto-gallery__frame">
              <div class="otto-gallery__inner" data-gallery-parallax>
                <Image
                  class="project-photo"
                  src={item.image}
                  alt={item.alt}
                  width={item.image.width}
                  height={item.image.height}
                  loading="eager"
                  decoding="async"
                />
              </div>
            </div>
            <div class="otto-gallery__meta otto-t12s">
              <span>{item.idx} · {item.title}</span>
              <span>{item.meta}</span>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class="otto-gallery__labels otto-t12" aria-live="polite">
      <span data-gallery-active-idx>01</span>
      <span data-gallery-active-cap>{galleryFrames[0].caption}</span>
    </div>

    <nav class="otto-gallery__ruler otto-t12" aria-label="Gallery chapters">
      {galleryFrames.map((item, idx) => (
        <button type="button" class={`otto-gallery__mark ${idx === 0 ? 'is-now' : ''}`} data-gallery-mark={idx}>
          {item.idx}
        </button>
      ))}
      <i class="otto-gallery__track-line" aria-hidden="true">
        <b class="otto-gallery__thumb" data-gallery-thumb></b>
      </i>
    </nav>
  </section>

  <!-- Act 4A: OH Architecture Mega Header + Asymmetric Lookbook & Telha Clarke Index Toggle -->
  <section id="works" class="works-atelier wrap" data-works-atelier data-view="lookbook" data-theme-zone="light" aria-label="Completed Commissions">
    <div class="oh-mega-header" data-mega-header style="padding-top: 0;">
      <div class="oh-mega-header__row1">
        <span class="oh-mega-word" data-mega-left>FEATURED</span>
      </div>
      <div class="oh-mega-header__row2">
        <span class="oh-mega-word oh-mega-word--indent" data-mega-right>WORKS</span>
        <span class="oh-mega-count">(0{commissions.length})</span>
      </div>
    </div>

    <div class="works-atelier__bar">
      <span class="otto-t12" style="color: var(--otto-muted);">Biratnagar &amp; Dharan · Verified Built Rooms</span>
      <div class="works-atelier__toggle" role="group" aria-label="Works display layout">
        <button type="button" class="works-atelier__btn otto-t12 is-active" data-works-view="lookbook" aria-pressed="true">Lookbook</button>
        <button type="button" class="works-atelier__btn otto-t12" data-works-view="index" aria-pressed="false">Index Ledger</button>
      </div>
    </div>

    <div class="works-lookbook">
      {commissions.map((c, idx) => (
        <article class={`lookbook-item--${idx === 0 ? 'a' : idx === 1 ? 'b' : 'c'}`}>
          <a class="lookbook-item__link" href={`/works/${c.slug}/`}>
            <div class="lookbook-item__media">
              <Image
                class="project-photo"
                src={c.image}
                alt={c.alt}
                width={c.image.width}
                height={c.image.height}
                loading={idx === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
            <div class="lookbook-item__foot">
              <h3 class="lookbook-item__title">{c.title}</h3>
              <span class="lookbook-item__dims otto-t12s">{lookbookDims[idx]}</span>
              <div class="lookbook-item__meta otto-t12">
                <span>0{idx + 1} · {c.typology} · {c.location}</span>
                <span>{c.year} · {c.focus} &#8599;</span>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>

    <div class="works-ledger-wrap">
      <ul class="works-ledger">
        {commissions.map((c, idx) => (
          <li>
            <a
              class="works-ledger__row"
              href={`/works/${c.slug}/`}
              data-ledger-row
              data-preview-src={c.image.src}
            >
              <span class="otto-t12" style="color: var(--otto-muted);">0{idx + 1}</span>
              <span class="works-ledger__title">{c.title}</span>
              <span class="otto-t12s works-ledger__hide-sm">{c.location}</span>
              <span class="otto-t12s works-ledger__hide-sm">{lookbookDims[idx]}</span>
              <span class="otto-t12s works-ledger__hide-sm">{c.year}</span>
              <span class="otto-t12">View Dossier &#8599;</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="works-ledger__preview" data-ledger-preview aria-hidden="true">
        <img src={commissions[0].image.src} alt="" />
      </div>
    </div>
  </section>

  <!-- Act 4B: Interactive 1:20 Vector CAD Elevation Sheet (BlueprintEngine) -->
  <section id="cad-sheet" class="cad-sheet-sec wrap" data-home-cad-section data-theme-zone="light" aria-label="Interactive Architectural CAD Drafting Sheet">
    <div class="cad-sheet__head">
      <div>
        <span class="otto-t12" style="color: var(--otto-muted); display:block; margin-bottom:0.5rem;">02 · Technical Drafting · 1:20 Elevation</span>
        <h2 class="cad-sheet__title">Measured Vector Elevations &amp; O-SNAP Ruler</h2>
      </div>
      <div class="cad-sheet__controls">
        <button type="button" class="cad-sheet__btn otto-t12 is-active" data-cad-comm="fluted_master_suite">RUB-MS-01</button>
        <button type="button" class="cad-sheet__btn otto-t12" data-cad-comm="formal_drawing_room">RUB-DR-02</button>
        <button type="button" class="cad-sheet__btn otto-t12" data-cad-comm="heritage_panelled_gallery">RUB-PG-03</button>
        <button type="button" class="cad-sheet__btn otto-t12 is-active" data-cad-tool="measure">Ruler</button>
        <button type="button" class="cad-sheet__btn otto-t12" data-cad-tool="pan">Pan</button>
        <button type="button" class="cad-sheet__btn otto-t12 is-active" data-cad-theme="warm_vellum">Vellum</button>
        <button type="button" class="cad-sheet__btn otto-t12" data-cad-theme="dark_obsidian">Obsidian</button>
        <button type="button" class="cad-sheet__btn otto-t12" data-cad-zoom="in">+</button>
        <button type="button" class="cad-sheet__btn otto-t12" data-cad-zoom="out">-</button>
        <button type="button" class="cad-sheet__btn otto-t12" data-cad-zoom="fit">Fit</button>
        <button type="button" class="cad-sheet__btn otto-t12" data-cad-export>Export SVG</button>
      </div>
    </div>

    <div class="cad-sheet__viewport">
      <canvas class="cad-sheet__canvas" data-home-cad-canvas></canvas>
    </div>
    <p class="cad-sheet__hint otto-t12s">
      <span>Click and drag in Ruler mode to measure real millimeters across Sal millwork bays (Ctrl + wheel to zoom).</span>
      <span>DIN EN ISO 7200 Studio Sheet · Riya Agrawal</span>
    </p>
  </section>

  <!-- Act 5A: Abrupt Dark Contrast Band (#1E1B1A) Staggered Commission Showcase -->
  <section id="collection" class="otto-collection" data-theme-zone="dark" aria-label="Rubiconius Architectural Archive">
    <p class="otto-collection__title otto-t120 otto-abs" style="--x: 14; --y: 18"><span class="otto-line"><span class="otto-line__in">R</span></span></p>
    <p class="otto-collection__count otto-t12 otto-abs" style="--x: 20; --y: 378">Commissions (03):</p>
    <h2 class="otto-collection__title otto-t120 otto-abs" style="--x: 253; --y: 18"><span class="otto-line"><span class="otto-line__in">Archive</span></span></h2>
    <p class="otto-collection__title otto-t120 otto-abs otto-abs--r" style="--r: 1423; --y: 18"><span class="otto-line"><span class="otto-line__in">(03)</span></span></p>

    {collectionCards.map((card, i) => (
      <>
        <a
          class="otto-collection__card otto-abs"
          href={card.href}
          data-otto-collection-card
          data-label={card.label}
          style={card.pos}
        >
          <span class="otto-collection__pic">
            <img src={card.image.src} width={card.image.width} height={card.image.height} alt={card.alt} loading="lazy" decoding="async" />
          </span>
        </a>
        <p class="otto-collection__name otto-t12 otto-abs" style={i === 0 ? '--x: 256; --y: 822' : i === 1 ? '--x: 610; --y: 724' : '--x: 964; --y: 974'}>
          <span>{card.num}</span>
          <span>{card.name}</span>
        </p>
        <p class="otto-collection__dims otto-abs" style={i === 0 ? '--x: 256; --y: 844' : i === 1 ? '--x: 610; --y: 746' : '--x: 964; --y: 996'}>
          {card.dims}
        </p>
      </>
    ))}
  </section>

  <!-- Act 5B: ANUC 4-Column Hairline Execution Ledger -->
  <section id="disciplines" class="anuc-grid" data-theme-zone="light" aria-label="Execution Disciplines">
    <div class="anuc-col">
      <div class="anuc-datum__sticky">
        <span class="otto-t12" style="color: var(--otto-muted);">Execution Ledger</span>
        <p class="anuc-datum__text">Single-desk civil, carpentry, stone, and luminaire accountability across Eastern Nepal.</p>
      </div>
    </div>
    <div class="anuc-col">
      <span class="anuc-num">01</span>
      <h3 class="anuc-title">Turnkey Civil &amp; Millwork</h3>
      <p class="anuc-desc">Full electrical routing, acoustic plasterwork, and seasoned Sal timber joinery crafted on site.</p>
      <figure class="anuc-plate" data-anuc-plate="0">
        <Image class="project-photo" src={studioJoinery} alt="Fluted Sal timber millwork detail" width={studioJoinery.width} height={studioJoinery.height} loading="lazy" />
      </figure>
    </div>
    <div class="anuc-col">
      <span class="anuc-num">02</span>
      <h3 class="anuc-title">Stone, Brass &amp; Glazing</h3>
      <p class="anuc-desc">Bookmatched honed marble slabs, anodized metal frames, and custom brushed brass fixtures.</p>
      <figure class="anuc-plate anuc-plate--2" data-anuc-plate="1">
        <Image class="project-photo" src={studioMarble} alt="Honed veined marble slab surface" width={studioMarble.width} height={studioMarble.height} loading="lazy" />
      </figure>
    </div>
    <div class="anuc-col">
      <span class="anuc-num">03</span>
      <h3 class="anuc-title">Furnishing &amp; Final Custody</h3>
      <p class="anuc-desc">Handpicked cane, woven linen, bespoke lighting geometry, and turnkey site handover.</p>
      <figure class="anuc-plate" data-anuc-plate="2">
        <Image class="project-photo" src={craftPlate.image} alt={craftPlate.alt} width={craftPlate.image.width} height={craftPlate.image.height} loading="lazy" />
      </figure>
    </div>
  </section>

  <!-- Act 5C: DHK Obsidian-Cut Manifesto -->
  <section id="manifesto" class="dhk-manifesto" data-theme-zone="dark" aria-label="Studio Manifesto">
    <div class="dhk-manifesto__inner wrap">
      <div class="dhk-manifesto__stage">
        <div class="dhk-manifesto__tag-col">
          <span class="dhk-manifesto__tag">rubiconius manifesto</span>
        </div>

        <div class="dhk-manifesto__we-col">
          <span class="dhk-manifesto__we" data-dhk-we>we</span>
        </div>

        <div class="dhk-manifesto__lines-col">
          <p class="dhk-line is-active" data-dhk-line="0">shape calm proportions.</p>
          <p class="dhk-line" data-dhk-line="1">craft honest timber &amp; stone.</p>
          <p class="dhk-line" data-dhk-line="2">calibrate warm daylight.</p>
          <p class="dhk-line" data-dhk-line="3">commit past the point of return.</p>

          <p class="dhk-manifesto__sub">
            Led by {site.founder} across Munal Path (Biratnagar) and Gita Mandir Line (Dharan), Nepal. Every commission carries full execution accountability. {site.hours} · {site.phoneDisplay}.
          </p>

          <div class="dhk-manifesto__actions">
            <button class="dhk-cta-btn" type="button" data-open-drawer data-drawer-context="Homepage Architectural Manifesto">
              <span>Commission a Space</span>
              <span aria-hidden="true">&#8599;</span>
            </button>
            <a class="dhk-secondary-link" href="/showroom/">
              <span>Enter 3D Material Study</span>
              <span aria-hidden="true">&#8599;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Act 6A: OTTO-Style 120svh Quiet Material Study Closing Stage (Difference Caption Bar) -->
  <section id="atelier-close" class="otto-close-stage" data-atelier-close data-theme-zone="light" aria-label="Material Palette Composition">
    <div class="otto-close-stage__media">
      {closeMaterials.map((mat, idx) => (
        <img
          src={mat.image.src}
          alt={mat.alt}
          width={mat.image.width}
          height={mat.image.height}
          loading="lazy"
          class={`otto-close-stage__img ${idx === 0 ? 'is-active' : ''}`}
          data-close-plate={idx}
        />
      ))}
    </div>

    <div class="otto-close-stage__words-track" aria-hidden="true">
      <div class="otto-close-stage__words otto-t12">
        <span>Material Board</span>
        <span data-close-active-label>Sal Timber</span>
        <span>Calibrated Daylight</span>
        <span style="text-align:right;">Studio Consultation</span>
      </div>
    </div>

    <div class="otto-close-stage__switch otto-t12">
      {closeMaterials.map((mat, idx) => (
        <button
          type="button"
          class={`otto-close-stage__btn ${idx === 0 ? 'is-active' : ''}`}
          data-close-mat={mat.id}
          aria-pressed={idx === 0 ? 'true' : 'false'}
        >
          {mat.label}
        </button>
      ))}
    </div>
  </section>

  <!-- Act 6B: Interactive Real-Time 3D Architectural Walkthrough Stage -->
  <ShowroomStage mode="inline" />
</Base>
