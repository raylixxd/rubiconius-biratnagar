---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { parquetPlate, site } from '../data/site';

// Real photography assets for architectural monograph plates & specimens
import realDiningHall from '../assets/real-dining-hall.jpg';
import realLivingRoom from '../assets/real-living-room.jpg';
import realMasterBedroom from '../assets/real-master-bedroom.jpg';
import realReadingCorner from '../assets/real-reading-corner.jpg';
import realLoungeVignette from '../assets/real-lounge-vignette.jpg';
import realWoodStudy from '../assets/real-wood-study.jpg';
import rubiconiusPracticeStudio from '../assets/studio-practice-workspace.jpg';
import rubiconiusJoinery from '../assets/studio-joinery.jpg';
import rubiconiusMarble from '../assets/studio-marble.webp';
import rubiconiusThreshold from '../assets/studio-threshold.jpg';
import rubiconiusWorkDharan from '../assets/studio-work-terrace.jpg';
import rubiconiusWorkMunal from '../assets/studio-work-suite.jpg';

// Monograph timeline milestones
const timelineMilestones = [
  {
    year: '2018 — 2020',
    title: 'Spatial Apprenticeship & Material Studies',
    location: 'Kolkata & Eastern Tradition',
    excerpt:
      'Formative years studying spatial proportion, hand-woven textiles, and traditional joinery techniques in Kolkata. Developing an architectural philosophy anchored in material honesty rather than surface ornamentation.',
    discipline: 'Spatial Research & Textile Curating',
    keyOutcome: 'Established the material ethos: daylight, solid timber, and lime plaster as structural truths.',
  },
  {
    year: '2021',
    title: 'Founding Rubiconius in Biratnagar',
    location: 'Munal Path, Biratnagar',
    excerpt:
      'Established the primary studio desk at Munal Path, Kochakhaltol. Addressed the regional vacuum in Eastern Nepal for disciplined, turnkey interior architecture across modern residences and executive offices.',
    discipline: 'Full Turnkey Practice',
    keyOutcome: 'First residential turnkey handovers delivered with full civil and electrical coordination.',
  },
  {
    year: '2022 — 2023',
    title: 'Foothills Expansion to Dharan',
    location: 'Gita Mandir Line, Dharan',
    excerpt:
      'Inaugurated the Dharan studio desk to serve private residences across Sunsari and Itahari. Built dedicated partnerships with master regional Sal woodworkers, stone masons, and iron smiths.',
    discipline: 'Regional Guild Collaboration',
    keyOutcome: 'Execution of the Formal Drawing Room salon and sunlit veranda extensions.',
  },
  {
    year: '2024 — Present',
    title: 'The Architectural Monograph Era',
    location: 'Biratnagar & Dharan Studios',
    excerpt:
      'Completing signature commissions including the Fluted Master Suite and Heritage Panelled Gallery. Pioneering interactive 3D WebGL material studies for prospective residential commissioners.',
    discipline: 'Monograph Commissions & 3D Spatial Studies',
    keyOutcome: '27 verified 5.0-star client reviews; standardizing the zero-compromise turnkey protocol.',
  },
];

// Materials philosophy tactile specimens
const materialSpecimens = [
  {
    num: '01',
    name: 'Seasoned Terai Sal Timber',
    typology: 'Native Shorea Robusta Hardwood',
    role: 'Wall Panelling, Exposed Rafters & Custom Bedsteads',
    swatchHex: '#4A3321',
    image: rubiconiusJoinery,
    alt: 'Precision vertical fluted Sal timber joinery and shadow gap detailing',
    description:
      'Harvested sustainably from the southern plains of Nepal. Renowned for supreme density and dimensional stability under subtropical humidity. Hand-finished in low-sheen organic oils that deepen into a rich amber patina over decades.',
  },
  {
    num: '02',
    name: 'Honed Kota Limestone & Marble',
    typology: 'Natural Sedimentary & Metamorphic Slabs',
    role: 'Cooling Thermal Mass & Monolithic Flooring',
    swatchHex: '#D8D3C9',
    image: rubiconiusMarble,
    alt: 'Book-matched veined natural marble slab macro detail',
    description:
      'Matte-honed Kota limestone and natural veined marble slabs introduce natural thermal damping against Eastern Nepal summer heat. The non-reflective surface softly diffuses high-angle daylight across the interior room envelope.',
  },
  {
    num: '03',
    name: 'Unlacquered Architectural Brass',
    typology: 'Living Metallic Alloy',
    role: 'Multi-Globe Sconces, Cabinet Pulls & Shadow Gaps',
    swatchHex: '#C9A97E',
    image: rubiconiusPracticeStudio,
    alt: 'Architectural studio worktable with unlacquered brass hardware and drawing drafts',
    description:
      'Uncoated, brushed brass hardware that ages organically with human touch and atmospheric oxygen. We utilize slender brass expansion inlays along stone thresholds and custom spun globe luminaires to provide low-glare warm pools of evening light.',
  },
  {
    num: '04',
    name: 'Hand-Troweled Lime Plaster',
    typology: 'Mineral Wall Coatings',
    role: 'Breathable Vertical Envelopes & Alcove Niches',
    swatchHex: '#EFECE6',
    image: rubiconiusWorkDharan,
    alt: 'Matte lime plaster feature wall paired with exposed timber ceiling rafters',
    description:
      'Traditional slaked lime and fine mineral aggregates applied with steel trowels. Naturally breathable, anti-fungal in monsoon climates, and micro-textured to catch shifting raking daylight without the artificial sheen of latex paints.',
  },
];

// Monograph portfolio plates
const monographPlates = [
  {
    index: '01',
    title: 'Fluted Master Suite Elevation',
    location: 'Biratnagar',
    typology: 'Private Residence',
    year: '2024',
    image: realMasterBedroom,
    alt: 'Fluted master bedroom suite with continuous vertical Sal timber panelling, tufted linen headboard, and brass sconces',
    specs: 'Solid Sal Timber · Linen · Brushed Brass',
  },
  {
    index: '02',
    title: 'Formal Reception Salon',
    location: 'Dharan',
    typology: 'Formal Reception',
    year: '2023',
    image: realLivingRoom,
    alt: 'Formal drawing room with royal-blue sofa, cognac leather chairs, honed marble floor, and multi-tier brass chandelier',
    specs: 'Honed Veined Marble · Indigo Upholstery · Garden Glazing',
  },
  {
    index: '03',
    title: 'Heritage Panelled Reading Alcove',
    location: 'Biratnagar',
    typology: 'Private Gallery',
    year: '2024',
    image: realReadingCorner,
    alt: 'Horizontal tongue-and-groove panelled wall with staggered Sal timber shelves and framed Mithila art',
    specs: 'Tongue-and-Groove Millwork · Mithila Art Framing',
  },
  {
    index: '04',
    title: 'Adjoining Dining & Sideboard Gallery',
    location: 'Dharan',
    typology: 'Formal Dining',
    year: '2023',
    image: realDiningHall,
    alt: 'Dining gallery with patterned feature wall, custom timber sideboard, marble floor, and cove lighting',
    specs: 'Custom Fluted Credenza · Recessed Coves · Marble Mass',
  },
  {
    index: '05',
    title: 'Sunlit Plinth & Fluted Portal',
    location: 'Concept Study 04',
    typology: 'Threshold Study',
    year: '2024',
    image: rubiconiusThreshold,
    alt: 'Sunlit gallery view with travertine plinth and vertical fluted hardwood portals',
    specs: 'Matte Lime Plaster · Travertine Plinth · Fluted Portals',
  },
  {
    index: '06',
    title: 'Curated Cane & Turned Brass Vignette',
    location: 'Studio Curation',
    typology: 'Bespoke Furnishing',
    year: '2024',
    image: realLoungeVignette,
    alt: 'Hand-woven cane armchairs, spun brass candle hurricane, reed mat, and cream cabinetry',
    specs: 'Woven Rattan · Unlacquered Brass · Natural Reed',
  },
  {
    index: '07',
    title: 'Garden Threshold & Fluted Pavilion',
    location: 'Munal Path, Biratnagar',
    typology: 'Veranda Extension',
    year: '2024',
    image: rubiconiusWorkMunal,
    alt: 'Pivoting black-framed glazing opening onto courtyard greenery with dark oak table joinery',
    specs: 'Slender Anodized Glazing · Solid Dark Oak · Limestone Paving',
  },
  {
    index: '08',
    title: 'Turned Timber & Bentwood Study',
    location: 'Private Residence',
    typology: 'Private Reading Wing',
    year: '2023',
    image: realWoodStudy,
    alt: 'Hand-turned dark Sal timber bedposts paired with bent-plywood leather seating',
    specs: 'Turned Hardwood · Bent-Plywood Leather · Honed Stone',
  },
];
---

<Base
  title="Practice & Architectural Monograph"
  description={`Inside ${site.name} — architectural interior practice led by ${site.founder} across Biratnagar and Dharan. Studio narrative, materials philosophy, leadership timeline, and turnkey disciplines.`}
>
  <!-- 01. COORDINATE DATUM STRIP -->
  <aside class="practice-datum wrap" aria-label="Monograph Datum & Studio Coordinates">
    <div class="practice-datum__inner">
      <div class="practice-datum__group">
        <span class="practice-datum__item practice-datum__item--highlight">VOL. 02 &middot; STUDIO MONOGRAPH</span>
        <span class="practice-datum__sep" aria-hidden="true">&middot;</span>
        <span class="practice-datum__item">{site.name.toUpperCase()}&trade;</span>
        <span class="practice-datum__sep" aria-hidden="true">&middot;</span>
        <span class="practice-datum__item">PRINCIPAL: {site.founder.toUpperCase()}</span>
      </div>

      <div class="practice-datum__group">
        <span class="practice-datum__item">
          BIRATNAGAR: 26.4678&deg; N, 87.2767&deg; E
        </span>
        <span class="practice-datum__sep" aria-hidden="true">&middot;</span>
        <span class="practice-datum__item">
          DHARAN: 26.8124&deg; N, 87.2834&deg; E
        </span>
        <span class="practice-datum__sep" aria-hidden="true">&middot;</span>
        <span class="practice-datum__item studio-clock" data-studio-clock>
          NPT STUDIO TIME
        </span>
      </div>

      <div class="practice-datum__group">
        <span class="practice-datum__badge">ACTIVE COMMISSIONS</span>
        <span class="practice-datum__sep" aria-hidden="true">&middot;</span>
        <span class="practice-datum__rating" aria-label="5.0 rating out of 27 verified client reviews">
          &#9733; {site.ratingScore} &middot; {site.reviewCount} REVIEWS
        </span>
      </div>
    </div>
  </aside>

  <!-- 02. MONUMENTAL EDITORIAL HERO -->
  <section class="practice-hero wrap" aria-labelledby="practice-hero-title">
    <div class="practice-hero__grid">
      <div class="practice-hero__title-col">
        <p class="section-kicker" data-reveal="fade" data-intro>
          Architectural Monograph &middot; {site.offices.map((o) => o.city).join(' & ')}
        </p>
        <h1 id="practice-hero-title" class="practice-hero__title" data-split="lines" data-intro>
          Spaces shaped around the quiet rituals of how you actually live.
        </h1>
        <div class="practice-hero__quote-box">
          <span class="practice-hero__quote-kicker">{site.commitmentKicker}</span>
          <blockquote class="practice-hero__quote">
            &ldquo;{site.commitmentQuote}&rdquo;
          </blockquote>
        </div>
      </div>

      <div class="practice-hero__lead-col">
        <p class="practice-hero__lead" data-reveal="up" data-intro data-delay="0.12">
          {site.founderBio[0]}
        </p>
        <p class="practice-hero__body" data-reveal="up" data-intro data-delay="0.2">
          {site.founderBio[1]}
        </p>
        <div class="practice-hero__metrics">
          <div class="practice-metric">
            <span class="practice-metric__num">100%</span>
            <span class="practice-metric__label">Turnkey Ownership</span>
          </div>
          <div class="practice-metric">
            <span class="practice-metric__num">2</span>
            <span class="practice-metric__label">Studios (Biratnagar &amp; Dharan)</span>
          </div>
          <div class="practice-metric">
            <span class="practice-metric__num">5.0</span>
            <span class="practice-metric__label">Verified Rating ({site.reviewCount} Reviews)</span>
          </div>
        </div>
        <div class="practice-hero__cta-row">
          <button class="btn btn--accent" type="button" data-fill data-open-drawer>
            <span class="btn__fill" aria-hidden="true"></span>
            <span>Initiate Studio Brief</span>
            <span class="btn__arrow" aria-hidden="true">&#8599;</span>
          </button>
          <a class="arch-cta arch-cta--muted" href="#studio-locator">
            <span>Explore Studio Locations &darr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 03. PRIMARY STUDIO WORKSPACE SPREAD & DOSSIER -->
  <section class="practice-spread wrap" aria-label="Studio Workspace and Practice Dossier">
    <figure class="case-plate is-landscape" data-gl data-gl-instant>
      <Image
        class="project-photo"
        src={parquetPlate.image}
        alt={parquetPlate.alt}
        width={parquetPlate.image.width}
        height={parquetPlate.image.height}
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="practice-spread__caption">
        <span>PLATE 01 &middot; STUDIO WORKBENCH &middot; {site.offices[0].address}</span>
        <span>ARCHITECTURAL SPECIMEN STUDY &middot; SAL TIMBER, STONE &amp; LINEN</span>
      </figcaption>
    </figure>

    <aside class="case-aside practice-aside">
      <span class="section-kicker">Studio Practice &amp; Offices</span>
      <div class="practice-offices">
        {site.offices.map((o) => (
          <a class="practice-office" href={o.mapUrl} target="_blank" rel="noopener noreferrer">
            <span class="practice-office__city">{o.city} Studio &#8599;</span>
            <span class="practice-office__addr">{o.address}</span>
            <span class="practice-office__coords">{o.coords}</span>
          </a>
        ))}
      </div>

      <dl class="case-facts">
        <div><dt>Principal &amp; Founder</dt><dd>{site.founder}</dd></div>
        <div><dt>Design Direction</dt><dd>{site.founderTitle}</dd></div>
        <div><dt>Consultation Hours</dt><dd>{site.hours}</dd></div>
        <div><dt>Direct Consultation Line</dt><dd><a href={`tel:+${site.whatsappNumber}`}>{site.phoneDisplay}</a></dd></div>
        <div><dt>Regional Footprint</dt><dd>Biratnagar, Dharan, Itahari &amp; Eastern Nepal</dd></div>
        <div><dt>Execution Scope</dt><dd>Turnkey Residential, Civil, Millwork &amp; Furnishings</dd></div>
      </dl>

      <div class="practice-channels-block">
        <span class="section-kicker">Verified Architectural Records</span>
        <div class="practice-channels">
          {site.socials.map((s) => (
            <a class="draw" href={s.href} target="_blank" rel="noopener noreferrer">{s.label} &#8599;</a>
          ))}
        </div>
      </div>

      <div class="practice-aside__actions">
        <button class="btn btn--accent" type="button" data-fill data-open-drawer>
          <span class="btn__fill" aria-hidden="true"></span>
          <span>Send Brief on WhatsApp</span>
          <span class="btn__arrow" aria-hidden="true">&#8599;</span>
        </button>
      </div>
    </aside>
  </section>

  <!-- 04. ARCHITECTURAL STUDIO NARRATIVE & LEADERSHIP DISCIPLINES -->
  <section class="practice-narrative wrap" aria-labelledby="narrative-heading">
    <div class="section-head">
      <span class="section-head__kicker">Studio Provenance &middot; Eastern Nepal</span>
      <h2 id="narrative-heading" class="section-head__title">
        Bridging the drafting table directly to the master artisan&rsquo;s workshop.
      </h2>
    </div>

    <div class="practice-narrative__grid">
      <article class="narrative-card">
        <span class="narrative-card__index">01</span>
        <h3 class="narrative-card__title">The Kolkata Apprenticeship</h3>
        <p class="narrative-card__text">
          Rubiconius was founded by Riya Agrawal following rigorous immersion in the design culture of Kolkata. Studying historical proportions, bespoke upholstery techniques, and rich Bengali craftsmanship revealed a stark truth: authentic luxury is never applied on the surface as ornamentation; it is engineered into the bone structure of the space.
        </p>
      </article>

      <article class="narrative-card">
        <span class="narrative-card__index">02</span>
        <h3 class="narrative-card__title">The Terai Architectural Reality</h3>
        <p class="narrative-card__text">
          Returning to Eastern Nepal, the practice identified an acute disparity: client residences were frequently surrendered to disconnected contractors, resulting in flimsy gypsum facades, glare-heavy tiles, and warped woodwork. Rubiconius introduced an uncompromising turnkey standard: every electrical conduit, shadow gap, and fluted joint is drawn to the millimeter and supervised on site.
        </p>
      </article>

      <article class="narrative-card">
        <span class="narrative-card__index">03</span>
        <h3 class="narrative-card__title">The Regional Guild Collaboration</h3>
        <p class="narrative-card__text">
          Rather than relying on imported flat-pack units, our studio operates in direct partnership with local master joiners, stone carvers, and blacksmiths in Morang and Sunsari. By elevating indigenous Sal timber and hand-cut Kota stone through disciplined modern detailing, each residence gains timeless acoustic stillness and generational durability.
        </p>
      </article>
    </div>
  </section>

  <!-- 05. INTERACTIVE MULTI-STAGE PRACTICE & LEADERSHIP TIMELINE -->
  <section class="practice-timeline-sec wrap" aria-labelledby="timeline-heading" data-practice-timeline>
    <div class="section-head">
      <span class="section-head__kicker">Evolutionary Trajectory &middot; 2018 &mdash; Present</span>
      <h2 id="timeline-heading" class="section-head__title">
        The chronological progression of our architectural practice.
      </h2>
    </div>

    <div class="timeline-shell">
      <nav class="timeline-nav" role="tablist" aria-label="Practice evolutionary timeline">
        {timelineMilestones.map((milestone, idx) => (
          <button
            type="button"
            role="tab"
            class={`timeline-btn ${idx === 0 ? 'is-active' : ''}`}
            data-timeline-btn={idx}
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-controls={`timeline-panel-${idx}`}
            id={`timeline-tab-${idx}`}
          >
            <span class="timeline-btn__year">{milestone.year}</span>
            <span class="timeline-btn__title">{milestone.title}</span>
            <span class="timeline-btn__loc">{milestone.location}</span>
          </button>
        ))}
      </nav>

      <div class="timeline-stages">
        {timelineMilestones.map((milestone, idx) => (
          <div
            id={`timeline-panel-${idx}`}
            role="tabpanel"
            class={`timeline-stage ${idx === 0 ? 'is-active' : ''}`}
            data-timeline-panel={idx}
            aria-labelledby={`timeline-tab-${idx}`}
          >
            <div class="timeline-stage__meta">
              <span class="timeline-stage__badge">{milestone.year}</span>
              <span class="timeline-stage__loc">{milestone.location}</span>
              <span class="timeline-stage__discipline">{milestone.discipline}</span>
            </div>
            <h3 class="timeline-stage__title">{milestone.title}</h3>
            <p class="timeline-stage__text">{milestone.excerpt}</p>
            <div class="timeline-stage__outcome">
              <span class="timeline-stage__outcome-label">Architectural Landmark</span>
              <p class="timeline-stage__outcome-val">{milestone.keyOutcome}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 06. MATERIALS PHILOSOPHY — THE TACTILE PALETTE -->
  <section class="practice-materials wrap" aria-labelledby="materials-heading">
    <div class="section-head">
      <span class="section-head__kicker">Materiality &middot; Olson Kundig &amp; Norm Architects Restraint</span>
      <h2 id="materials-heading" class="section-head__title">
        Materials that gain dignity through sunlight, touch, and age.
      </h2>
      <p class="section-head__lead">
        We compose rooms exclusively from genuine physical matter. No synthetic laminates, no imitation wood grain, and no disposable finishes.
      </p>
    </div>

    <div class="materials-grid">
      {materialSpecimens.map((spec) => (
        <article class="material-card">
          <div class="material-card__preview">
            <Image
              class="material-card__img"
              src={spec.image}
              alt={spec.alt}
              width={spec.image.width}
              height={spec.image.height}
              loading="lazy"
            />
          </div>
          <div class="material-card__head">
            <span class="material-card__num">{spec.num}</span>
            <div class="material-card__swatch-wrap">
              <span class="material-card__swatch" style={`background-color: ${spec.swatchHex};`} aria-hidden="true"></span>
              <span class="material-card__hex">{spec.swatchHex}</span>
            </div>
          </div>
          <h3 class="material-card__name">{spec.name}</h3>
          <p class="material-card__typology">{spec.typology}</p>
          <div class="material-card__role">
            <span class="material-card__role-label">Primary Application</span>
            <span class="material-card__role-val">{spec.role}</span>
          </div>
          <p class="material-card__desc">{spec.description}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- 07. FIVE TURNKEY EXECUTION DISCIPLINES -->
  <section class="practice-disciplines wrap" aria-labelledby="disciplines-heading">
    <div class="section-head">
      <span class="section-head__kicker">Comprehensive Execution Disciplines</span>
      <h2 id="disciplines-heading" class="section-head__title">
        The five core stages of end-to-end turnkey delivery.
      </h2>
    </div>

    <div class="disciplines-list">
      {site.services.map((service) => (
        <article class="discipline-row">
          <div class="discipline-row__col-idx">
            <span class="discipline-row__idx">{service.index}</span>
          </div>
          <div class="discipline-row__col-title">
            <h3 class="discipline-row__title">{service.name}</h3>
          </div>
          <div class="discipline-row__col-desc">
            <p class="discipline-row__desc">{service.detail}</p>
          </div>
          <div class="discipline-row__col-action">
            <button class="draw" type="button" data-open-drawer>
              Inquire Stage &rarr;
            </button>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- 08. PHOTOGRAPHIC MONOGRAPH GRID -->
  <section class="practice-gallery wrap" aria-labelledby="gallery-heading">
    <div class="section-head">
      <span class="section-head__kicker">Architectural Plate Catalogue</span>
      <h2 id="gallery-heading" class="section-head__title">
        Selected built works across Morang &amp; Sunsari.
      </h2>
      <p class="section-head__lead">
        Documenting residential chambers, reception salons, and tactile alcoves completed by our Biratnagar and Dharan studios.
      </p>
    </div>

    <div class="gallery-grid">
      {monographPlates.map((plate) => (
        <figure class="gallery-card">
          <div class="gallery-card__stage">
            <Image
              class="gallery-card__img"
              src={plate.image}
              alt={plate.alt}
              width={plate.image.width}
              height={plate.image.height}
              loading="lazy"
            />
            <span class="gallery-card__idx-pill">{plate.index}</span>
          </div>
          <figcaption class="gallery-card__caption">
            <div class="gallery-card__head">
              <span class="gallery-card__loc">{plate.location} &middot; {plate.year}</span>
              <span class="gallery-card__typo">{plate.typology}</span>
            </div>
            <h3 class="gallery-card__title">{plate.title}</h3>
            <p class="gallery-card__specs">{plate.specs}</p>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="gallery-footer-action">
      <a class="btn btn--accent" href="/works/">
        <span class="btn__fill" aria-hidden="true"></span>
        <span>View Full Portfolio &amp; Dossiers</span>
        <span class="btn__arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <!-- 09. INTERACTIVE ARCHITECTURAL STUDIO LOCATOR -->
  <section id="studio-locator" class="practice-locator wrap" data-studio-locator aria-labelledby="locator-heading">
    <div class="section-head">
      <span class="section-head__kicker">Physical Studios &amp; Consultations</span>
      <h2 id="locator-heading" class="section-head__title">
        Visit our studio desks in {site.offices.map((o) => o.city).join(' & ')}.
      </h2>
      <p class="section-head__lead">
        Consultations are held privately at our Munal Path desk in Biratnagar or Gita Mandir Line studio in Dharan by prior appointment.
      </p>
    </div>

    <div class="locator-shell">
      <div class="locator-panel">
        <div class="locator-tabs" role="tablist" aria-label="Studio locations">
          {site.offices.map((o, idx) => (
            <button
              type="button"
              role="tab"
              class={`locator-tab ${idx === 0 ? 'is-active' : ''}`}
              data-locator-tab
              data-embed-url={o.embedUrl}
