---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { parquetPlate, site } from '../data/site';
---
<Base
  title="About & Studios"
  description="Meet Rubiconius founder Riya Agrawal — interior design studio offices in Biratnagar and Dharan, design philosophy, and turnkey process."
>
  <section class="inner-hero inner-hero--split wrap">
    <div class="inner-hero__title-col">
      <p class="section-kicker" data-reveal="fade" data-intro>About the Studio &middot; Biratnagar &amp; Dharan</p>
      <h1 class="inner-hero__title" data-split="lines" data-intro>Spaces shaped around how you actually live.</h1>
    </div>
    <div class="inner-hero__lead-col">
      <p class="hero__lead" data-reveal="up" data-intro data-delay="0.12">
        Led by {site.founder} with an eye honed in Kolkata, Rubiconius delivers composed residential and commercial interiors combining honest millwork, handpicked accents, and regional craftspeople.
      </p>
    </div>
  </section>

  <section class="practice-spread wrap">
    <figure class="case-plate is-landscape">
      <Image
        class="project-photo"
        src={parquetPlate.image}
        alt={parquetPlate.alt}
        width={parquetPlate.image.width}
        height={parquetPlate.image.height}
        loading="eager"
        fetchpriority="high"
      />
    </figure>

    <aside class="case-aside practice-aside">
      <span class="section-kicker">Studio Offices &amp; Hours</span>
      <div class="practice-offices">
        {site.offices.map((o) => (
          <a class="practice-office" href={o.mapUrl} target="_blank" rel="noopener noreferrer">
            <span class="practice-office__city">{o.city} Office &#8599;</span>
            <span class="practice-office__addr">{o.address}</span>
          </a>
        ))}
      </div>

      <dl class="case-facts">
        <div><dt>Founder</dt><dd>{site.founder}</dd></div>
        <div><dt>Hours</dt><dd>{site.hours}</dd></div>
        <div><dt>Practice</dt><dd>Residential &amp; Commercial Turnkey Interiors</dd></div>
        <div><dt>Direct Line</dt><dd>{site.phoneDisplay}</dd></div>
      </dl>

      <div class="practice-channels-block">
        <span class="section-kicker">Verified Channels</span>
        <div class="practice-channels">
          {site.socials.map((s) => (
            <a class="draw" href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
          ))}
        </div>
      </div>

      <div style="padding-top: 0.5rem;">
        <button class="btn btn--accent" type="button" data-fill data-open-drawer>
          <span class="btn__fill" aria-hidden="true"></span>
          <span>Send Brief on WhatsApp</span>
          <span class="btn__arrow" aria-hidden="true">&#8599;</span>
        </button>
      </div>
    </aside>
  </section>

  <section class="practice-story wrap">
    <div class="practice-story__grid">
      <div class="case-section">
        <h2>Why &ldquo;Rubiconius&rdquo;</h2>
        <blockquote class="practice-quote">
          &ldquo;{site.commitmentQuote}&rdquo;
        </blockquote>
        {site.founderBio.map((p) => (
          <p class="practice-bio-p">{p}</p>
        ))}
      </div>

      <div class="case-section">
        <h2>Three Core Stages</h2>
        <ol class="practice-stages">
          <li>
            <strong>01 &middot; Site Study &amp; Spatial Planning</strong>
            <span>Site measurement, circulation layout, and electrical/storage logic tailored strictly to your daily routine.</span>
          </li>
          <li>
            <strong>02 &middot; Civil, Carpentry &amp; Lighting Execution</strong>
            <span>Fine woodwork, false ceilings, stone flooring, iron partitions, and custom cabinetry built alongside regional craftspeople.</span>
          </li>
          <li>
            <strong>03 &middot; Soft Furnishings &amp; Handpicked Finish</strong>
            <span>Upholstery, decorative light fittings, artwork framing, and handpicked finishing accessories curated for handover day.</span>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section id="studio-locator" class="practice-locator wrap" data-studio-locator>
    <div class="section-head">
      <span class="section-head__kicker">Studio Locator</span>
      <h2 class="section-head__title">Visit our studios in Biratnagar &amp; Dharan.</h2>
    </div>

    <div class="locator-shell">
      <div class="locator-panel">
        <div class="locator-tabs" role="tablist" aria-label="Studio locations">
          {site.offices.map((o, idx) => (
            <button
              type="button"
              role="tab"
              class={`locator-tab ${idx === 0 ? 'is-active' : ''}`}
              data-locator-tab
              data-embed-url={o.embedUrl}
              data-map-url={o.mapUrl}
              data-addr={o.address}
              data-coords={o.coords}
              data-city={o.city}
              aria-selected={idx === 0 ? 'true' : 'false'}
            >
              <span class="locator-tab__head">
                <span class="locator-tab__idx">{o.index}</span>
                <span class="locator-tab__city">{o.city}</span>
              </span>
              <span class="locator-tab__addr">{o.address}</span>
              <span class="locator-tab__meta">{o.coords} &middot; {o.note}</span>
            </button>
          ))}
        </div>

        <div class="locator-meta">
          <span class="section-kicker">Consultation Hours</span>
          <p class="locator-meta__hours">{site.hours} &middot; {site.phoneDisplay}</p>
        </div>

        <div class="locator-actions">
          <a
            class="btn btn--accent"
            data-fill
            data-locator-directions
            href={site.offices[0].mapUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="btn__fill" aria-hidden="true"></span>
            <span>Open Directions</span>
            <span class="btn__arrow" aria-hidden="true">&#8599;</span>
          </a>
          <a class="arch-cta arch-cta--muted" href={`tel:+${site.whatsappNumber}`}>
            <span>Call {site.phoneDisplay}</span>
          </a>
        </div>
      </div>

      <div class="locator-map-frame">
        <div class="locator-datum">
          <span class="locator-datum__addr" data-locator-active-addr>{site.offices[0].address}</span>
          <span class="locator-datum__coords" data-locator-active-coords>{site.offices[0].coords}</span>
        </div>
        <div class="locator-map-stage" data-lenis-prevent>
          <iframe
            class="locator-iframe"
            data-locator-iframe
            src={site.offices[0].embedUrl}
            title={`Rubiconius Studio Map — ${site.offices[0].city}`}
            loading="eager"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</Base>
