{/* =========================================================================
    5. INTERACTIVE CLIENT CONTROLLER (POVs, Lighting, PBR Drawer, Telemetry)
    ========================================================================= */}
<script>
  function setupShowroomInteractions() {
    const root = document.querySelector<HTMLElement>('[data-showroom-container]');
    if (!root) return;

    // Elements
    const hudCoords = root.querySelector<HTMLElement>('[data-hud-coords]');
    const hudPos = root.querySelector<HTMLElement>('[data-hud-pos]');
    const hudSolar = root.querySelector<HTMLElement>('[data-hud-solar]');
    const hudActivePov = root.querySelector<HTMLElement>('[data-hud-active-pov]');
    const todBtns = root.querySelectorAll<HTMLButtonElement>('.showroom-tod__btn');
    const todNote = root.querySelector<HTMLElement>('[data-tod-note]');
    const todIndicator = root.querySelector<HTMLElement>('.showroom-tod__indicator');

    // POV Navigation
    const povStripTabs = root.querySelectorAll<HTMLButtonElement>('.showroom-pov-strip__tab');
    const povDrawerToggle = root.querySelector<HTMLButtonElement>('[data-pov-drawer-toggle]');
    const povDrawer = root.querySelector<HTMLElement>('[data-showroom-pov]');
    const povClose = root.querySelector<HTMLButtonElement>('[data-pov-close]');
    const povBackdrop = root.querySelector<HTMLElement>('[data-pov-backdrop]');
    const povJumpBtns = root.querySelectorAll<HTMLButtonElement>('[data-jump-u]');
    const povItems = root.querySelectorAll<HTMLElement>('.showroom-pov__item');

    // PBR Material Drawer
    const pbrTrigger = root.querySelector<HTMLButtonElement>('[data-pbr-trigger]');
    const pbrDrawer = root.querySelector<HTMLElement>('[data-showroom-pbr]');
    const pbrClose = root.querySelector<HTMLButtonElement>('[data-pbr-close]');
    const pbrBackdrop = root.querySelector<HTMLElement>('[data-pbr-backdrop]');
    const pbrTabs = root.querySelectorAll<HTMLButtonElement>('.showroom-pbr__tab');
    const pbrPanels = root.querySelectorAll<HTMLElement>('.showroom-pbr__panel');

    let activeU = 0;
    let rafId: number | null = null;

    // --- Helper: Jump Camera via Lenis or Showroom Debug API ---
    function jumpToU(u: number) {
      if (window.__showroomDebug && typeof window.__showroomDebug.jumpTo === 'function') {
        window.__showroomDebug.jumpTo(u);
      } else {
        const docH = document.documentElement.scrollHeight - window.innerHeight;
        window.scrollTo({
          top: u * Math.max(1, docH),
          behavior: 'smooth',
        });
      }
    }

    // --- Helper: Update Active POV Tab Highlight ---
    function setActivePovHighlight(u: number) {
      const waypoints = [
        { name: '01 MASTER BAY', u: 0.0, label: 'Master Bay', solar: '85° AZIMUTH · 14° ALTITUDE' },
        { name: '02 JOINERY AXIS', u: 0.25, label: 'Joinery Axis', solar: '142° AZIMUTH · 28° ALTITUDE' },
        { name: '03 THRESHOLD', u: 0.50, label: 'Threshold', solar: '198° AZIMUTH · 36° ALTITUDE' },
        { name: '04 MATERIAL TABLE', u: 0.75, label: 'Material Table', solar: '248° AZIMUTH · 18° ALTITUDE' },
      ];

      // Find closest
      let closest = waypoints[0];
      let minDiff = 999;
      for (const wp of waypoints) {
        const diff = Math.abs(u - wp.u);
        if (diff < minDiff) {
          minDiff = diff;
          closest = wp;
        }
      }

      if (hudActivePov) {
        hudActivePov.textContent = closest.name;
      }
      if (hudSolar && document.documentElement.dataset.lighting !== 'dusk') {
        hudSolar.textContent = closest.solar;
      }

      povStripTabs.forEach((tab) => {
        const tabU = parseFloat(tab.dataset.povU || '0');
        const isActive = Math.abs(tabU - closest.u) < 0.12;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', String(isActive));
      });

      povItems.forEach((item) => {
        const itemU = parseFloat(item.dataset.povTarget || '0');
        const isActive = Math.abs(itemU - closest.u) < 0.12;
        item.classList.toggle('is-active', isActive);
      });
    }

    // --- 1. POV Strip Tab Clicks ---
    povStripTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const u = parseFloat(tab.dataset.povU || '0');
        jumpToU(u);
        setActivePovHighlight(u);
      });
    });

    // --- 2. Camera POV Drawer Open / Close ---
    function openPovDrawer() {
      if (!povDrawer) return;
      povDrawer.setAttribute('aria-hidden', 'false');
      povDrawerToggle?.setAttribute('aria-expanded', 'true');
      document.body.classList.add('has-modal-open');
    }

    function closePovDrawer() {
      if (!povDrawer) return;
      povDrawer.setAttribute('aria-hidden', 'true');
      povDrawerToggle?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('has-modal-open');
    }

    povDrawerToggle?.addEventListener('click', openPovDrawer);
    povClose?.addEventListener('click', closePovDrawer);
    povBackdrop?.addEventListener('click', closePovDrawer);

    povJumpBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const u = parseFloat(btn.dataset.jumpU || '0');
        jumpToU(u);
        setActivePovHighlight(u);
        closePovDrawer();
      });
    });

    // --- 3. Lighting & Time-of-Day Switcher ---
    function setLightingMode(mode: string, duskVal: number, kelvin: string, note?: string) {
      document.documentElement.dataset.lighting = mode;
      window.dispatchEvent(
        new CustomEvent('studio:lighting', {
          detail: {
            mode,
            dusk: duskVal > 0.5 ? true : (duskVal > 0 ? 0.45 : false),
            kelvin,
          },
        })
      );

      todBtns.forEach((btn, idx) => {
        const isSelected = btn.dataset.tod === mode;
        btn.classList.toggle('is-active', isSelected);
        btn.setAttribute('aria-checked', String(isSelected));
        if (isSelected && todIndicator) {
          todIndicator.style.transform = `translateX(${idx * 100}%)`;
        }
      });

      if (todNote && note) {
        todNote.textContent = note;
      }

      if (hudSolar) {
        if (mode === 'dusk') {
          hudSolar.textContent = 'TWILIGHT & COVE ILLUMINATION (2200K)';
        } else if (mode === 'golden') {
          hudSolar.textContent = '248° AZIMUTH · 12° ALTITUDE (3200K)';
        } else {
          hudSolar.textContent = '85° AZIMUTH · 14° ALTITUDE (5500K)';
        }
      }
    }

    todBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.tod || 'morning';
        const duskVal = parseFloat(btn.dataset.dusk || '0');
        const kelvin = btn.dataset.kelvin || '5500K';
        const note = btn.getAttribute('title') || '';
        setLightingMode(mode, duskVal, kelvin, note);
      });
    });

    // --- 4. PBR Material Inspection Drawer Open / Close ---
    function openPbrDrawer() {
      if (!pbrDrawer) return;
      pbrDrawer.setAttribute('aria-hidden', 'false');
      pbrTrigger?.setAttribute('aria-expanded', 'true');
      document.body.classList.add('has-modal-open');
    }

    function closePbrDrawer() {
      if (!pbrDrawer) return;
      pbrDrawer.setAttribute('aria-hidden', 'true');
      pbrTrigger?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('has-modal-open');
    }

    pbrTrigger?.addEventListener('click', openPbrDrawer);
    pbrClose?.addEventListener('click', closePbrDrawer);
    pbrBackdrop?.addEventListener('click', closePbrDrawer);

    // PBR Tab Switching
    pbrTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.dataset.pbrTab;
        pbrTabs.forEach((t) => {
          const isActive = t === tab;
          t.classList.toggle('is-active', isActive);
          t.setAttribute('aria-selected', String(isActive));
        });

        pbrPanels.forEach((panel) => {
          const isMatch = panel.id === `pbr-panel-${targetId}`;
          panel.classList.toggle('is-active', isMatch);
          panel.hidden = !isMatch;
        });
      });
    });

    // --- 5. Real-Time Telemetry Loop (RAF) ---
    function updateTelemetry() {
      if (window.__showroomDebug && typeof window.__showroomDebug.getState === 'function') {
        const state = window.__showroomDebug.getState();
        activeU = state.u;
        if (hudPos && state.cam) {
          hudPos.textContent = `X: ${state.cam[0].toFixed(2)} · Y: ${state.cam[1].toFixed(2)} · Z: ${state.cam[2].toFixed(2)}`;
        }
      } else {
        const scrollLimit = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        activeU = Math.max(0, Math.min(1, window.scrollY / scrollLimit));
        if (hudPos) {
          const approxX = (-0.45 + activeU * 0.6).toFixed(2);
          const approxY = (1.56 - activeU * 0.1).toFixed(2);
          const approxZ = (7.20 - activeU * 13.9).toFixed(2);
          hudPos.textContent = `X: ${approxX} · Y: ${approxY} · Z: ${approxZ}`;
        }
      }

      setActivePovHighlight(activeU);
      rafId = requestAnimationFrame(updateTelemetry);
    }

    rafId = requestAnimationFrame(updateTelemetry);

    // --- 6. Global Keyboard Shortcuts ---
    function onKeyDown(e: KeyboardEvent) {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;

      if (e.key === 'Escape') {
        closePbrDrawer();
        closePovDrawer();
      } else if (e.key === 'm' || e.key === 'M') {
        const isPbrOpen = pbrDrawer?.getAttribute('aria-hidden') === 'false';
        if (isPbrOpen) closePbrDrawer();
        else openPbrDrawer();
      } else if (e.key === 'l' || e.key === 'L') {
        const currentMode = document.documentElement.dataset.lighting || 'morning';
        const modes = ['morning', 'golden', 'dusk'];
        const nextIdx = (modes.indexOf(currentMode) + 1) % modes.length;
        const nextMode = modes[nextIdx];
        const nextBtn = root?.querySelector<HTMLButtonElement>(`[data-tod="${nextMode}"]`);
        if (nextBtn) nextBtn.click();
      } else if (e.key >= '1' && e.key <= '4') {
        const idx = parseInt(e.key, 10) - 1;
        if (povStripTabs[idx]) {
          povStripTabs[idx].click();
        }
      }
    }

    window.addEventListener('keydown', onKeyDown);

    // Cleanup on View Transition
    document.addEventListener(
      'astro:before-swap',
      () => {
        if (rafId) cancelAnimationFrame(rafId);
        window.removeEventListener('keydown', onKeyDown);
      },
      { once: true }
    );
  }

  // Bind to Astro lifecycle
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupShowroomInteractions);
  } else {
    setupShowroomInteractions();
  }
  document.addEventListener('astro:page-load', setupShowroomInteractions);
</script>

