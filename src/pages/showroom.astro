---
import Base from '../layouts/Base.astro';
import ShowroomStage from '../components/ShowroomStage.astro';
import { commissions, materialStudies, showroom, site } from '../data/site';
import studioPracticeWorkspace from '../assets/studio-practice-workspace.jpg';
import studioJoinery from '../assets/studio-joinery.jpg';
import studioThreshold from '../assets/studio-threshold.jpg';
import studioMarble from '../assets/studio-marble.webp';
import realMasterBedroom from '../assets/real-master-bedroom.jpg';
import realLivingRoom from '../assets/real-living-room.jpg';
import realLoungeVignette from '../assets/real-lounge-vignette.jpg';

// Architectural PBR substrate definitions with empirical optical measurements
const pbrMaterials = [
  {
    id: 'kota-limestone',
    index: '01',
    name: 'Honed Kota Limestone',
    typology: 'Mineral Floorplane & Thermal Plinth',
    quarryOrigin: 'Kota Formation, Calibrated Slabs',
    finish: 'Matte Diamond Grit 400 Honed',
    albedoHex: '#D8CDBD',
    roughness: 0.72,
    metalness: 0.00,
    reflectanceF0: 0.040,
    ior: 1.54,
    bumpDepth: '1.2mm Micro-relief',
    aoCavity: '0.86 Cavity Contact',
    thermalMass: '1.82 W/m·K (Passive Cooling)',
    climateSuitability: 'Biratnagar Humid Subtropical (Tarai Plains)',
    specs: '30mm calibrated slab depth with recessed 3mm hairline brass expansion joints.',
    notes: 'Low-glare mineral substrate reflecting indirect daylight evenly without thermal trapping.',
    image: studioPracticeWorkspace,
  },
  {
    id: 'sal-timber',
    index: '02',
    name: 'Seasoned Sal Hardwood',
    typology: 'Fluted Wall Panelling & Ceiling Canopy',
    quarryOrigin: 'Eastern Terai Forest Reserves',
    finish: 'Natural Tung Oil, Hand-Rubbed Matte',
    albedoHex: '#4A3321',
    roughness: 0.46,
    metalness: 0.00,
    reflectanceF0: 0.038,
    ior: 1.51,
    bumpDepth: '2.4mm Fluted Reveal',
    aoCavity: '0.94 Flute Shadow',
    thermalMass: '0.14 W/m·K (Acoustic & Thermal Buffer)',
    climateSuitability: 'Kiln-seasoned for Eastern Nepal monsoon humidity cycles',
    specs: '24mm on-center vertical fluting with concealed tongue-and-groove fastenings.',
    notes: 'Dense Shorea robusta timber milled by regional joiners in Munal Path studio.',
    image: studioJoinery,
  },
  {
    id: 'verde-alpi',
    index: '03',
    name: 'Verde Alpi Serpentinite',
    typology: 'Monolithic Hearth & Kitchen Island Plinth',
    quarryOrigin: 'Metamorphic Serpentinite Deposit',
    finish: 'Satin Silk Honed, Low-Reflectance',
    albedoHex: '#1D2A22',
    roughness: 0.24,
    metalness: 0.00,
    reflectanceF0: 0.052,
    ior: 1.58,
    bumpDepth: '0.8mm Calcite Vein Relief',
    aoCavity: '0.82 Base Inset',
    thermalMass: '2.10 W/m·K (High Thermal Inertia)',
    climateSuitability: 'Resistant to moisture and oil staining',
    specs: '50mm mitered book-matched slabs with chamfered 1.5mm eased perimeter edges.',
    notes: 'Deep alpine green matrix interlaced with stark white crystalline calcite veining.',
    image: studioMarble,
  },
  {
    id: 'unlacquered-brass',
    index: '04',
    name: 'Unlacquered Spun Brass',
    typology: 'Architectural Hardware & Cove Liners',
    quarryOrigin: 'Cu70/Zn30 Architectural Alloy',
    finish: 'Longitudinally Spun & Fine-Brushed',
    albedoHex: '#C9A97E',
    roughness: 0.28,
    metalness: 1.00,
    reflectanceF0: 0.850,
    ior: 2.14,
    bumpDepth: '0.3mm Lathe Micro-grooves',
    aoCavity: '0.78 Shadow Reveal',
    thermalMass: '115 W/m·K (Conductor)',
    climateSuitability: 'Living metal that develops rich golden-brown patina over time',
    specs: 'Solid turned pulls, shadow reveal extrusions, and spun pendant fixtures.',
    notes: 'Warm metallic highlights catching morning sunbeams and incandescent evening lamps.',
    image: realLoungeVignette,
  },
  {
    id: 'lime-plaster',
    index: '05',
    name: 'Troweled Matte Lime Plaster',
    typology: 'Monolithic Wall Plane & Ceiling Soffit',
    quarryOrigin: 'Traditional Slaked Lime & Fine Marble Dust',
    finish: 'Multi-Coat Steel Trowel, Natural Matte',
    albedoHex: '#EFECE6',
    roughness: 0.88,
    metalness: 0.00,
    reflectanceF0: 0.035,
    ior: 1.50,
    bumpDepth: '0.5mm Trowel Micro-texture',
    aoCavity: '0.64 Corner Fillet',
    thermalMass: '0.80 W/m·K (Breathable Substrate)',
    climateSuitability: 'Natural vapor permeability prevents condensation',
    specs: 'Three-layer application on masonry substrate with seamless bullnose returns.',
    notes: 'Diffuses raking window daylight softly across interior volumes without glare.',
    image: studioThreshold,
  },
];

// Architectural Camera POVs across the 3D exhibition space
const cameraPOVs = [
  {
    id: 'master-bay',
    index: '01',
    label: 'Master Bay',
    name: '01 Master Bay',
    u: 0.0,
    cam: [-0.45, 1.56, 7.2],
    target: [0.25, 1.44, 1.5],
    coords: 'X: -0.45 · Y: +1.56 · Z: +7.20',
    description: 'Axial perspective across entry foyer & limestone threshold under directional morning light.',
    aperture: 'f/2.8 · 54° FOV · 7.20m Depth',
    thumb: studioPracticeWorkspace,
  },
  {
    id: 'joinery-axis',
    index: '02',
    label: 'Joinery Axis',
    name: '02 Joinery Axis',
    u: 0.25,
    cam: [-0.85, 1.48, 3.95],
    target: [2.25, 1.02, 2.35],
    coords: 'X: -0.85 · Y: +1.48 · Z: +3.95',
    description: 'Alignment with vertical fluted Sal timber panelling and concealed warm cove illumination.',
    aperture: 'f/3.2 · 54° FOV · 3.95m Depth',
    thumb: studioJoinery,
  },
  {
    id: 'threshold',
    index: '03',
    label: 'Threshold',
    name: '03 Threshold',
    u: 0.5,
    cam: [0.85, 1.52, -0.1],
    target: [-2.15, 1.12, -1.75],
    coords: 'X: +0.85 · Y: +1.52 · Z: -0.10',
    description: 'Verde Alpi serpentinite plinth and courtyard glass portal with fluid floor reflections.',
    aperture: 'f/2.8 · 54° FOV · 2.15m Depth',
    thumb: studioMarble,
  },
  {
    id: 'material-table',
    index: '04',
    label: 'Material Table',
    name: '04 Material Table',
    u: 0.75,
    cam: [-0.25, 1.56, -2.85],
    target: [0, 1.18, -5.85],
    coords: 'X: -0.25 · Y: +1.56 · Z: -2.85',
    description: 'Tactile substrate inspection table showcasing mineral and timber specimens in calibrated daylight.',
    aperture: 'f/4.0 · 54° FOV · 3.10m Depth',
    thumb: studioThreshold,
  },
];

// Volumetric Sunbeam & Lighting Modes
const lightingModes = [
  {
    id: 'morning',
    label: 'Morning Mist',
    shortLabel: 'Mist',
    kelvin: '5500K',
    sunAngle: '85° Azimuth · 14° Alt',
    duskVal: 0,
    description: 'Crisp diffuse daylight through morning mist across the Morang plains.',
  },
  {
    id: 'golden',
    label: 'Golden Hour',
    shortLabel: 'Golden',
    kelvin: '3200K',
    sunAngle: '248° Azimuth · 12° Alt',
    duskVal: 0.45,
    description: 'Warm raking late-afternoon sunbeams highlighting fluted woodwork chamfers.',
  },
  {
    id: 'dusk',
    label: 'Deep Dusk / Night',
    shortLabel: 'Dusk',
    kelvin: '2200K',
    sunAngle: 'Twilight Cove & Pendant',
    duskVal: 1.0,
    description: 'Atmospheric twilight with glowing brass sconces and warm architectural cove illumination.',
  },
];
---

<Base
  title="3D Architectural Exhibition | Material Study"
  description={`Interactive 3D architectural exhibition of Rubiconius — Honed stone, fluted timber, and dynamic volumetric daylight across ${site.city}.`}
  immersive
>
  <div class="showroom-page-container" data-showroom-container>
    {/* Base Three.js Fullscreen Viewport & Waypoint Track */}
    <ShowroomStage mode="fullscreen" />

    {/* =========================================================================
        1. ARCHITECTURAL HUD OVERLAYS: Coordinates Grid & Live POV Telemetry
        ========================================================================= */}
    <div class="showroom-hud" data-showroom-hud aria-label="Architectural Exhibition Telemetry HUD">
      {/* Precision Hairline Corner Framing Brackets */}
      <div class="showroom-hud__corner showroom-hud__corner--tl" aria-hidden="true">
        <span class="crosshair-h"></span>
        <span class="crosshair-v"></span>
      </div>
      <div class="showroom-hud__corner showroom-hud__corner--tr" aria-hidden="true">
        <span class="crosshair-h"></span>
        <span class="crosshair-v"></span>
      </div>
      <div class="showroom-hud__corner showroom-hud__corner--bl" aria-hidden="true">
        <span class="crosshair-h"></span>
        <span class="crosshair-v"></span>
      </div>
      <div class="showroom-hud__corner showroom-hud__corner--br" aria-hidden="true">
        <span class="crosshair-h"></span>
        <span class="crosshair-v"></span>
      </div>

      {/* Top Architectural Datum Bar */}
      <header class="showroom-hud__datum" aria-label="Spatial Coordinates Header">
        <div class="showroom-hud__datum-group">
          <span class="showroom-hud__datum-tag">RUBICONIUS ARCHITECTURE</span>
          <span class="showroom-hud__datum-sep">/</span>
          <span class="showroom-hud__coords" data-hud-coords>26.4678° N &middot; 87.2767° E</span>
          <span class="showroom-hud__datum-sep">/</span>
          <span class="showroom-hud__datum-alt">ELEV +72.4m</span>
        </div>

        <div class="showroom-hud__datum-group showroom-hud__datum-group--right">
          <span class="showroom-hud__mode-badge" data-hud-mode="story">3D SPATIAL MONOGRAPH</span>
          <button
            type="button"
            class="showroom-hud__pbr-trigger"
            data-pbr-trigger
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="pbr-inspection-drawer"
            title="Open PBR Material Inspection Matrix (Press M)"
          >
            <span class="pbr-trigger__icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                <rect x="2" y="2" width="5" height="5" stroke="currentColor" stroke-width="1.2" />
                <rect x="9" y="2" width="5" height="5" stroke="currentColor" stroke-width="1.2" />
                <rect x="2" y="9" width="5" height="5" stroke="currentColor" stroke-width="1.2" />
                <rect x="9" y="9" width="5" height="5" stroke="currentColor" stroke-width="1.2" />
              </svg>
            </span>
            <span class="pbr-trigger__label">PBR Inspector</span>
          </button>
        </div>
      </header>

      {/* Center Architectural Alignment Reticle */}
      <div class="showroom-hud__reticle" aria-hidden="true">
        <span class="reticle-line reticle-line--h"></span>
        <span class="reticle-line reticle-line--v"></span>
        <span class="reticle-center"></span>
        <span class="reticle-cardinal reticle-cardinal--n">N</span>
        <span class="reticle-cardinal reticle-cardinal--s">S</span>
        <span class="reticle-cardinal reticle-cardinal--e">E</span>
        <span class="reticle-cardinal reticle-cardinal--w">W</span>
      </div>

      {/* Floating Camera POV Indicator Strip (Quick Axial Tabs) */}
      <nav class="showroom-pov-strip" aria-label="Camera POV Quick Select">
        <div class="showroom-pov-strip__inner">
          <span class="showroom-pov-strip__title">CAMERA POV:</span>
          <div class="showroom-pov-strip__tabs" role="tablist">
            {cameraPOVs.map((pov, idx) => (
              <button
                type="button"
                role="tab"
                class={`showroom-pov-strip__tab ${idx === 0 ? 'is-active' : ''}`}
                data-pov-u={pov.u}
                data-pov-id={pov.id}
                aria-selected={idx === 0 ? 'true' : 'false'}
                aria-label={`Jump to ${pov.name}`}
                title={`Jump to ${pov.name} (${pov.aperture})`}
              >
                <span class="tab-index">{pov.index}</span>
                <span class="tab-label">{pov.label}</span>
              </button>
            ))}
          </div>
          <button
            type="button"
            class="showroom-pov-strip__more"
            data-pov-drawer-toggle
            aria-expanded="false"
            aria-controls="camera-pov-drawer"
            title="View Full Architectural POV Drawer"
          >
            <span class="sr-only">Toggle Camera Drawer</span>
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </button>
        </div>
      </nav>

      {/* Bottom Telemetry Readout Cluster */}
      <div class="showroom-hud__telemetry" aria-label="Real-time Camera Telemetry">
        <div class="telemetry-block">
          <span class="telemetry-label">POSITION</span>
          <span class="telemetry-value" data-hud-pos>X: -0.45 &middot; Y: +1.56 &middot; Z: +7.20</span>
        </div>
        <div class="telemetry-block telemetry-block--hide-mobile">
          <span class="telemetry-label">OPTICS</span>
          <span class="telemetry-value" data-hud-optics>54° BASE FOV &middot; F/2.8 SPATIAL CAL</span>
        </div>
        <div class="telemetry-block telemetry-block--hide-mobile">
          <span class="telemetry-label">SOLAR ANGLE</span>
          <span class="telemetry-value" data-hud-solar>85° AZIMUTH &middot; 14° ALTITUDE</span>
        </div>
        <div class="telemetry-block">
          <span class="telemetry-label">CURRENT POV</span>
          <span class="telemetry-value telemetry-value--accent" data-hud-active-pov>01 MASTER BAY</span>
        </div>
      </div>
    </div>

    {/* =========================================================================
        2. LIGHTING & TIME-OF-DAY MODE SWITCHER: Volumetric Sunbeam Shift
        ========================================================================= */}
    <aside class="showroom-tod" aria-label="Lighting and Time of Day Controls">
      <div class="showroom-tod__pill" role="radiogroup" aria-label="Time-of-day lighting atmosphere">
        <span class="showroom-tod__indicator" aria-hidden="true"></span>
        {lightingModes.map((mode, idx) => (
          <button
            type="button"
            role="radio"
            class={`showroom-tod__btn ${idx === 0 ? 'is-active' : ''}`}
            data-tod={mode.id}
            data-dusk={mode.duskVal}
            data-kelvin={mode.kelvin}
            data-sun={mode.sunAngle}
            aria-checked={idx === 0 ? 'true' : 'false'}
            aria-label={`${mode.label} (${mode.kelvin})`}
            title={`${mode.label} — ${mode.description}`}
          >
            <span class="showroom-tod__icon" aria-hidden="true">
              {mode.id === 'morning' && (
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                  <circle cx="8" cy="8" r="3.2" stroke="currentColor" stroke-width="1.2" />
                  <path d="M8 1V3M8 13V15M1 8H3M13 8H15M3.05 3.05L4.46 4.46M11.54 11.54L12.95 12.95M3.05 12.95L4.46 11.54M11.54 4.46L12.95 3.05" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                </svg>
              )}
              {mode.id === 'golden' && (
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                  <path d="M2 13H14M4 10C4 6.68629 6.68629 4 10 4C11.5 4 12.8 4.6 13.7 5.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                  <path d="M8 1V3M2.5 4.5L4 5.5M1.5 8.5L3.5 9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                </svg>
              )}
              {mode.id === 'dusk' && (
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                  <path d="M13.5 9.5C13.5 12.8137 10.8137 15.5 7.5 15.5C4.18629 15.5 1.5 12.8137 1.5 9.5C1.5 6.18629 4.18629 3.5 7.5 3.5C8.1 3.5 8.7 3.6 9.2 3.8C8.5 4.8 8 6.1 8 7.5C8 10.5 10.5 13 13.5 13C13.8 13 14.1 12.9 14.4 12.8C13.9 13.9 13.5 9.5 13.5 9.5Z" stroke="currentColor" stroke-width="1.2" />
                </svg>
              )}
            </span>
            <span class="showroom-tod__label">{mode.shortLabel}</span>
            <span class="showroom-tod__kelvin">{mode.kelvin}</span>
          </button>
        ))}
      </div>
      <p class="showroom-tod__note" data-tod-note>
        {lightingModes[0].description}
      </p>
    </aside>

    {/* =========================================================================
        3. CAMERA POV NAVIGATION DRAWER: Architectural Monograph Thumbnail Tabs
        ========================================================================= */}
    <div
      id="camera-pov-drawer"
      class="showroom-pov"
      data-showroom-pov
      role="region"
      aria-label="Camera POV Monograph Drawer"
      aria-hidden="true"
    >
      <div class="showroom-pov__backdrop" data-pov-backdrop></div>
      <div class="showroom-pov__drawer" data-lenis-prevent>
        <div class="showroom-pov__header">
          <div class="showroom-pov__title-cluster">
            <span class="showroom-pov__kicker">CAMERA CALIBRATION &middot; 4 KEY AXES</span>
            <h3 class="showroom-pov__title">Architectural Exhibition POVs</h3>
          </div>
          <button
            type="button"
            class="showroom-pov__close"
            data-pov-close
            aria-label="Close Camera POV Drawer"
          >
            <span>&times;</span>
          </button>
        </div>

        <div class="showroom-pov__list" role="list">
          {cameraPOVs.map((pov, idx) => (
            <article
              class={`showroom-pov__item ${idx === 0 ? 'is-active' : ''}`}
              data-pov-target={pov.u}
              data-pov-key={pov.id}
              role="listitem"
            >
              <div class="showroom-pov__thumb">
                <img src={pov.thumb.src} alt={pov.name} loading="lazy" />
                <span class="showroom-pov__indicator" aria-hidden="true">
                  <span class="pov-pulse"></span>
                </span>
                <span class="showroom-pov__tag">{pov.index}</span>
              </div>
              <div class="showroom-pov__meta">
                <div class="showroom-pov__name-row">
                  <h4 class="showroom-pov__name">{pov.name}</h4>
                  <span class="showroom-pov__u-val">u={pov.u.toFixed(2)}</span>
                </div>
                <p class="showroom-pov__coords-spec">{pov.coords}</p>
                <p class="showroom-pov__desc">{pov.description}</p>
                <div class="showroom-pov__footer-row">
                  <span class="showroom-pov__optics">{pov.aperture}</span>
                  <button
                    type="button"
                    class="showroom-pov__jump-btn"
                    data-jump-u={pov.u}
                    aria-label={`Jump camera to ${pov.name}`}
                  >
                    <span>Align Camera</span>
                    <span aria-hidden="true">&rarr;</span>
                  </button>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>

    {/* =========================================================================
        4. MATERIAL INSPECTION DRAWER: Real-Time PBR Material Breakdown
        ========================================================================= */}
    <div
      id="pbr-inspection-drawer"
      class="showroom-pbr"
      data-showroom-pbr
      role="dialog"
      aria-modal="true"
      aria-label="PBR Material Specification Matrix"
      aria-hidden="true"
    >
      <div class="showroom-pbr__backdrop" data-pbr-backdrop></div>
      <div class="showroom-pbr__drawer" data-lenis-prevent>
        {/* Drawer Header */}
        <div class="showroom-pbr__header">
          <div class="showroom-pbr__title-block">
            <span class="showroom-pbr__kicker">PHYSICALLY BASED RENDERING &middot; SUBSTRATE MATRIX</span>
            <h2 class="showroom-pbr__title">Architectural Material Breakdown</h2>
          </div>
          <button
            type="button"
            class="showroom-pbr__close"
            data-pbr-close
            aria-label="Close PBR Material Drawer (Esc)"
          >
            <span>Close [Esc]</span>
          </button>
        </div>

        {/* Substrate Selector Bar */}
        <div class="showroom-pbr__selector" role="tablist" aria-label="Select material substrate">
          {pbrMaterials.map((mat, idx) => (
            <button
              type="button"
              role="tab"
              class={`showroom-pbr__tab ${idx === 0 ? 'is-active' : ''}`}
              data-pbr-tab={mat.id}
              aria-selected={idx === 0 ? 'true' : 'false'}
              aria-controls={`pbr-panel-${mat.id}`}
              id={`pbr-tab-${mat.id}`}
            >
              <span class="pbr-swatch" style={`background-color: ${mat.albedoHex};`} aria-hidden="true"></span>
              <span class="pbr-tab-index">{mat.index}</span>
              <span class="pbr-tab-name">{mat.name}</span>
            </button>
          ))}
        </div>

        {/* Material Panels */}
        <div class="showroom-pbr__panels">
          {pbrMaterials.map((mat, idx) => (
            <div
              id={`pbr-panel-${mat.id}`}
              class={`showroom-pbr__panel ${idx === 0 ? 'is-active' : ''}`}
              role="tabpanel"
              aria-labelledby={`pbr-tab-${mat.id}`}
              hidden={idx !== 0}
            >
              <div class="showroom-pbr__grid">
                {/* Visual Macro Photograph Showcase */}
                <div class="showroom-pbr__media">
                  <div class="showroom-pbr__imgwrap">
                    <img src={mat.image.src} alt={mat.name} loading="lazy" />
                    <div class="showroom-pbr__badge">
                      <span class="badge-dot" style={`background-color: ${mat.albedoHex};`}></span>
                      <span>ALBEDO: {mat.albedoHex}</span>
                    </div>
                  </div>
                  <div class="showroom-pbr__origin">
                    <span class="origin-label">SPECIFICATION & ORIGIN</span>
                    <p class="origin-text">{mat.quarryOrigin}</p>
                    <p class="origin-finish">{mat.finish}</p>
                  </div>
                </div>

                {/* Empirical PBR Meters & Optical Properties */}
                <div class="showroom-pbr__details">
                  <div class="showroom-pbr__hero-meta">
                    <span class="meta-typology">{mat.typology}</span>
                    <h3 class="meta-title">{mat.name}</h3>
                    <p class="meta-notes">{mat.notes}</p>
                  </div>

                  {/* Real-time PBR Parameter Gauges */}
                  <div class="showroom-pbr__props">
                    <h4 class="props-heading">Empirical PBR Parameters</h4>

                    {/* Roughness */}
                    <div class="pbr-meter-group">
                      <div class="pbr-meter-header">
                        <span class="pbr-meter-label">Microfacet Roughness (α)</span>
                        <span class="pbr-meter-val">{mat.roughness.toFixed(2)}</span>
                      </div>
                      <div class="pbr-meter-track">
                        <div class="pbr-meter-bar" style={`width: ${mat.roughness * 100}%;`}></div>
                      </div>
                      <span class="pbr-meter-sub">
                        {mat.roughness > 0.6 ? 'High diffuse scatter (matte)' : 'Specular reflection (silk sheen)'}
                      </span>
                    </div>

                    {/* Metalness */}
                    <div class="pbr-meter-group">
