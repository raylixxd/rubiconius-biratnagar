import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CaseShowcase from '../../components/CaseShowcase.astro';
import { commissions, site } from '../../data/site';

export function getStaticPaths() {
  return commissions.map((commission, index) => ({
    params: { slug: commission.slug },
    props: {
      commission,
      commissionIndex: index,
      nextCommission: commissions[(index + 1) % commissions.length],
      nextIndex: (index + 1) % commissions.length,
    },
  }));
}

const { commission, commissionIndex, nextCommission, nextIndex } = Astro.props;
const isPortrait = commission.image.height > commission.image.width;
const totalStudies = String(commissions.length).padStart(2, '0');
const studyNum = String(commissionIndex + 1).padStart(2, '0');
const nextStudyNum = String(nextIndex + 1).padStart(2, '0');

// Architectural CAD metadata & SVG blueprints inspired by 40_otto_objects & 06_unseen
interface ArchitecturalBlueprint {
  docRef: string;
  spanDimensions: string;
  ceilingDatum: string;
  volumeM3: string;
  footprintM2: string;
  tolerance: string;
  lightingSpec: string;
  acousticIndex: string;
  turnkeyDuration: string;
  millimeterPills: string[];
  blueprintTitle: string;
  blueprintSheet: string;
  blueprintScale: string;
  blueprintSvg: {
    viewBox: string;
    pathMarkup: string;
    annotations: { x: number; y: number; text: string; align?: 'start' | 'middle' | 'end' }[];
    dimensions: { x1: number; y1: number; x2: number; y2: number; label: string; offset?: number }[];
  };
  materialDetails: {
    name: string;
    scientificSpec: string;
    swatchHex: string;
    textureSensory: string;
    provenanceGuild: string;
    jointDetail: string;
  }[];
}

