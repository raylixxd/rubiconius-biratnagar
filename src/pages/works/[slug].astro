<Base
  title={`${commission.title} — Architectural Monograph`}
  description={`${commission.summary} Detailed architectural space dossier, millimeter CAD blueprints, materiality provenance, and room photography across ${commission.location}, Nepal.`}
>
  <div class="monograph-page" data-monograph-page>

    <!-- ACT 1: COORDINATE MONOGRAPH HEADER & FULL-BLEED HERO STAGE -->
    <header class="monograph-header wrap" data-monograph-header>
      <div class="monograph-header__datum-bar" data-reveal="fade">
        <div class="datum-col">
          <span class="datum-tag">MONOGRAPH REGISTRY</span>
          <span class="datum-value">{blueprint.docRef}</span>
        </div>
        <div class="datum-col">
          <span class="datum-tag">STUDY INDEX</span>
          <span class="datum-value">{studyNum} / {totalStudies} &middot; {commission.typology}</span>
        </div>
        <div class="datum-col datum-col--desktop">
          <span class="datum-tag">GEOGRAPHIC DATUM</span>
          <span class="datum-value">{commission.location.toUpperCase()}, NEPAL &middot; ELEV 72M</span>
        </div>
        <div class="datum-col">
          <span class="datum-tag">COMMISSION YEAR</span>
          <span class="datum-value">{commission.year}</span>
        </div>
      </div>

      <nav class="monograph-breadcrumb" aria-label="Breadcrumb" data-reveal="fade">
        <a href="/works/" class="draw">&larr; Return to Portfolio Index</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">{commission.title}</span>
      </nav>

      <div class="monograph-title-block">
        <div class="monograph-kicker-row">
          <span class="section-kicker">Space Dossier &middot; {commission.typology} &middot; {commission.location}</span>
          <span class="monograph-tolerance-badge" aria-hidden="true">{blueprint.tolerance}</span>
        </div>

        <h1 class="monograph-hero__title" data-split="lines" data-intro>
          {commission.title}
        </h1>

        <!-- Millimeter Span Tags (Otto Objects inspired CAD tags) -->
        <div class="monograph-cad-pills" role="list" aria-label="Architectural dimensions and tolerances">
          {blueprint.millimeterPills.map((pill) => (
            <span class="cad-pill" role="listitem">
              <span class="cad-pill__dot" aria-hidden="true"></span>
              <span>{pill}</span>
            </span>
          ))}
        </div>

        <p class="monograph-hero__lead" data-reveal="up" data-intro data-delay="0.1">
          {commission.summary}
        </p>
      </div>
    </header>

    <!-- FULL-BLEED UNSCRIMMED HERO APERTURE (FLIP Handoff Anchor) -->
    <section class="monograph-hero-stage wrap" aria-label={`${commission.title} Hero Stage`}>
      <figure
        class={`monograph-hero__plate case-plate ${isPortrait ? 'is-portrait' : 'is-landscape'}`}
        data-gl
        data-gl-instant
        data-gl-flip={commission.slug}
      >
        <div class="monograph-hero__parallax" data-editorial-parallax>
          <Image
            class="project-photo monograph-hero__img"
            src={commission.image}
            alt={commission.alt}
            width={commission.image.width}
            height={commission.image.height}
            loading="eager"
            decoding="sync"
            fetchpriority="high"
          />
        </div>

        <!-- Architectural Blueprint Corner Stamps (CAD Monograph Aesthetic) -->
        <div class="cad-stamp cad-stamp--tl" aria-hidden="true">
          <span>{site.name.toUpperCase()} ARCHITECTURAL DOSSIER</span>
          <span>{blueprint.docRef}</span>
        </div>
        <div class="cad-stamp cad-stamp--tr" aria-hidden="true">
          <span>DATUM: {commission.location.toUpperCase()}</span>
          <span>26.4678° N &middot; 87.2767° E</span>
        </div>
        <div class="cad-stamp cad-stamp--bl" aria-hidden="true">
          <span>{blueprint.blueprintScale}</span>
          <span>TOLERANCE {blueprint.tolerance}</span>
        </div>
        <div class="cad-stamp cad-stamp--br" aria-hidden="true">
          <span>PLATE {studyNum} / {totalStudies}</span>
          <span>COMPLETED {commission.year}</span>
        </div>
      </figure>

      <!-- Room Metric Bar directly beneath hero -->
      <div class="monograph-metrics-bar">
        <div class="metric-cell">
          <span class="metric-label">Enclosed Volume</span>
          <strong class="metric-value">{blueprint.volumeM3}</strong>
          <span class="metric-sub">Air space datum</span>
        </div>
        <div class="metric-cell">
          <span class="metric-label">Plan Footprint</span>
          <strong class="metric-value">{blueprint.footprintM2}</strong>
          <span class="metric-sub">Net usable floor</span>
        </div>
        <div class="metric-cell">
          <span class="metric-label">Ceiling Plane</span>
          <strong class="metric-value">{blueprint.ceilingDatum}</strong>
          <span class="metric-sub">Clear architectural head</span>
        </div>
        <div class="metric-cell">
          <span class="metric-label">Turnkey Period</span>
          <strong class="metric-value">{blueprint.turnkeyDuration}</strong>
          <span class="metric-sub">Design to handover</span>
        </div>
      </div>
    </section>

    <!-- ACT 2: TWO-COLUMN ARCHITECTURAL PLATE SHOWCASE (SVG CAD Blueprint + Detail Zoom) -->
    <section class="monograph-plate-showcase wrap" aria-labelledby="showcase-cad-heading">
      <header class="monograph-section-head">
        <div class="section-head__left">
          <span class="monograph-section-idx">01 / TECHNICAL ELEVATION</span>
          <h2 id="showcase-cad-heading" class="monograph-section-title">
            Architectural Plate Showcase &middot; CAD Blueprint & Detail Zoom
          </h2>
        </div>
        <div class="section-head__right">
          <span class="monograph-cad-badge">{blueprint.blueprintSheet}</span>
        </div>
      </header>

      <div class="monograph-showcase-grid">
        <!-- COLUMN 1: SVG Vector Architectural Blueprint Drawing -->
        <div class="showcase-col showcase-col--blueprint" data-blueprint-pane>
          <div class="blueprint-card">
            <div class="blueprint-card__head">
              <div class="blueprint-indicator">
                <span class="blueprint-dot" aria-hidden="true"></span>
                <span class="blueprint-title">{blueprint.blueprintTitle}</span>
              </div>
              <span class="blueprint-scale-tag">{blueprint.blueprintScale}</span>
            </div>

            <div class="blueprint-svg-container" role="img" aria-label={`${blueprint.blueprintTitle} technical elevation drawing with millimeter dimensions`}>
              <svg
                class="blueprint-svg"
                viewBox={blueprint.blueprintSvg.viewBox}
                preserveAspectRatio="xMidYMid meet"
                xmlns="http://www.w3.org/2000/svg"
              >
                <!-- Architectural Drafting Grid Background -->
                <defs>
                  <pattern id={`cad-grid-${commission.slug}`} width="30" height="30" patternUnits="userSpaceOnUse">
                    <path d="M 30 0 L 0 0 0 30" fill="none" stroke="currentColor" stroke-width="0.35" opacity="0.12" />
                  </pattern>
                </defs>
                <rect width="100%" height="100%" fill={`url(#cad-grid-${commission.slug})`} />

                <!-- Dynamic Path Markup for each Project Blueprint -->
                <g class="blueprint-paths" set:html={blueprint.blueprintSvg.pathMarkup} />

                <!-- Technical Annotations -->
                {blueprint.blueprintSvg.annotations.map((annot) => (
                  <text
                    x={annot.x}
                    y={annot.y}
                    class="blueprint-text"
                    text-anchor={annot.align || 'start'}
                    fill="currentColor"
                  >
                    {annot.text}
                  </text>
                ))}

                <!-- Dimension Lines & Leader Arrows -->
                {blueprint.blueprintSvg.dimensions.map((dim) => (
                  <g class="blueprint-dim">
                    <line x1={dim.x1} y1={dim.y1} x2={dim.x2} y2={dim.y2} stroke="currentColor" stroke-width="1.0" />
                    <circle cx={dim.x1} cy={dim.y1} r="2.5" fill="currentColor" />
                    <circle cx={dim.x2} cy={dim.y2} r="2.5" fill="currentColor" />
                    <text
                      x={(dim.x1 + dim.x2) / 2}
                      y={(dim.y1 + dim.y2) / 2 - 8}
                      class="blueprint-dim-text"
                      text-anchor="middle"
                      fill="currentColor"
                    >
                      {dim.label}
                    </text>
                  </g>
                ))}
              </svg>
            </div>

            <div class="blueprint-card__foot">
              <span class="blueprint-foot-note">All millwork tolerances ±0.5mm verified on-site by {site.founder}.</span>
              <span class="blueprint-watermark">RUBICONIUS / VERIFIED COMMISSION</span>
            </div>
          </div>
        </div>

        <!-- COLUMN 2: High-Resolution Photo Zoom & Detail Elevation -->
        <div class="showcase-col showcase-col--photo">
          <div class="photo-zoom-card">
            <div class="photo-zoom-card__head">
              <span class="zoom-kicker">High-Resolution Photographic Zoom</span>
              <span class="zoom-status">TACTILE LENS &middot; 1:1 RESOLUTION</span>
            </div>

            <figure class="photo-zoom-media" data-zoom-container>
              <Image
                class="project-photo zoom-img"
                src={commission.detailImage || commission.image}
                alt={`Detailed architectural joinery and material texture in ${commission.title}`}
                width={commission.detailImage ? commission.detailImage.width : commission.image.width}
                height={commission.detailImage ? commission.detailImage.height : commission.image.height}
                loading="lazy"
                decoding="async"
              />
              <div class="zoom-target-reticle" aria-hidden="true">
                <span class="reticle-line reticle-line--h"></span>
                <span class="reticle-line reticle-line--v"></span>
                <span class="reticle-tag">MACRO FOCUS</span>
              </div>
            </figure>

            <div class="photo-zoom-card__meta">
              <div class="zoom-meta-row">
                <span class="zoom-label">FOCAL DISCIPLINE</span>
                <span class="zoom-value">{commission.focus}</span>
              </div>
              <div class="zoom-meta-row">
                <span class="zoom-label">MATERIAL DATUM</span>
                <span class="zoom-value">{commission.materials[0]?.label || 'Natural Architectural Finish'}</span>
              </div>
              <div class="zoom-meta-row">
                <span class="zoom-label">ACOUSTIC BEHAVIOR</span>
                <span class="zoom-value">{blueprint.acousticIndex}</span>
              </div>
              <div class="zoom-meta-row">
                <span class="zoom-label">PHOTOMETRIC PROFILE</span>
                <span class="zoom-value">{blueprint.lightingSpec}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ACT 3: MEASURED STUDIES (Integrated WebGL Plate Inspector from CaseShowcase) -->
    <CaseShowcase commission={commission} />

    <!-- ACT 4: MATERIALITY SWATCH MATRIX (Tactile Textures & Craft Origins) -->
    <section class="monograph-materiality-matrix wrap" aria-labelledby="materiality-matrix-heading">
      <header class="monograph-section-head">
        <div class="section-head__left">
          <span class="monograph-section-idx">02 / TACTILE PALETTE</span>
          <h2 id="materiality-matrix-heading" class="monograph-section-title">
            Materiality Swatch Matrix & Craft Guild Origins
          </h2>
        </div>
        <div class="section-head__right">
          <span class="monograph-cad-badge">4 ARCHITECTURAL SPECIMENS</span>
        </div>
      </header>

      <div class="materiality-matrix-grid" role="list">
        {blueprint.materialDetails.map((mat, idx) => (
          <article class="material-card" role="listitem">
            <header class="material-card__head">
              <div class="material-swatch-chip" style={`background-color: ${mat.swatchHex};`} aria-hidden="true"></div>
              <div class="material-card__titles">
                <span class="material-spec-code">SPEC 0{idx + 1} &middot; {mat.swatchHex}</span>
                <h3 class="material-name">{mat.name}</h3>
              </div>
            </header>

            <p class="material-scientific">{mat.scientificSpec}</p>

            <div class="material-card__body">
              <div class="material-param">
                <span class="param-label">TACTILE SURFACE TEXTURE</span>
                <p class="param-text">{mat.textureSensory}</p>
              </div>

              <div class="material-param">
                <span class="param-label">SUPPLIER & CRAFT PROVENANCE</span>
                <p class="param-text">{mat.provenanceGuild}</p>
              </div>

              <div class="material-param">
                <span class="param-label">JOINERY METHODOLOGY</span>
                <p class="param-text param-text--mono">{mat.jointDetail}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ACT 5: SPACE DOSSIER TECHNICAL SPECIFICATION SHEET & ARCHITECTURAL NARRATIVE -->
    <section class="monograph-dossier-story wrap" aria-labelledby="story-dossier-heading">
      <header class="monograph-section-head">
        <div class="section-head__left">
          <span class="monograph-section-idx">03 / MONOGRAPH ARCHIVE</span>
          <h2 id="story-dossier-heading" class="monograph-section-title">
            Space Dossier Specifications & Narrative Chapters
          </h2>
        </div>
      </header>

      <div class="monograph-dossier-grid">
        <!-- LEFT: Architectural Specification Sheet Table -->
        <div class="dossier-specs-pane">
          <div class="specs-table-card">
            <div class="specs-table-card__head">
              <span class="specs-title">TECHNICAL ARCHIVE REGISTRY</span>
              <span class="specs-code">{blueprint.docRef}</span>
            </div>

            <dl class="specs-table">
              <div class="spec-row">
                <dt>Typology</dt>
                <dd>{commission.typology}</dd>
              </div>
              <div class="spec-row">
                <dt>Commission Year</dt>
                <dd>{commission.year}</dd>
              </div>
              <div class="spec-row">
                <dt>Regional Sector</dt>
                <dd>{commission.location}, Eastern Nepal</dd>
              </div>
              <div class="spec-row">
                <dt>Plan Footprint</dt>
                <dd>{blueprint.footprintM2}</dd>
              </div>
              <div class="spec-row">
                <dt>Enclosed Air Volume</dt>
                <dd>{blueprint.volumeM3}</dd>
              </div>
              <div class="spec-row">
                <dt>Ceiling Clear Head</dt>
                <dd>{blueprint.ceilingDatum}</dd>
              </div>
              <div class="spec-row">
                <dt>Primary Millwork</dt>
                <dd>{commission.focus}</dd>
              </div>
              <div class="spec-row">
                <dt>Dimensional Tolerance</dt>
                <dd>{blueprint.tolerance}</dd>
              </div>
              <div class="spec-row">
                <dt>Photometric Design</dt>
                <dd>{blueprint.lightingSpec}</dd>
              </div>
              <div class="spec-row">
                <dt>Acoustic Dampening</dt>
                <dd>{blueprint.acousticIndex}</dd>
              </div>
              <div class="spec-row">
                <dt>Turnkey Period</dt>
                <dd>{blueprint.turnkeyDuration}</dd>
              </div>
              <div class="spec-row">
                <dt>Lead Architect</dt>
                <dd>{site.founder} ({site.founderTitle})</dd>
              </div>
            </dl>

            <div class="specs-table-cta">
              <button
                class="btn btn--accent monograph-consult-btn"
                type="button"
                data-fill
                data-open-drawer
                data-drawer-context={`${commission.title} (${commission.location})`}
              >
                <span class="btn__fill" aria-hidden="true"></span>
                <span>Commission a Similar Space</span>
                <span class="btn__arrow" aria-hidden="true">&#8599;</span>
              </button>
            </div>
          </div>
        </div>

        <!-- RIGHT: Architectural Narrative Chapters & Principle Statement -->
        <div class="dossier-narrative-pane">
          <div class="narrative-statement-pullquote">
            <span class="pullquote-tag">STUDIO PRINCIPLE</span>
            <blockquote class="pullquote-text">
              “Architecture is not applied ornamentation; it is the deliberate discipline of light, honest jointure, and materials that mature alongside the family.”
            </blockquote>
            <cite class="pullquote-author">— {site.founder}, Principal Designer</cite>
          </div>

          <div class="narrative-chapters">
            {commission.narrative.map((chapter, cIdx) => (
              <article class="narrative-chapter">
                <div class="chapter-number">CHAPTER 0{cIdx + 1}</div>
                <h3 class="chapter-heading">{chapter.heading}</h3>
                <p class="chapter-text">{chapter.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ACT 6: NEXT COMMISSION APERTURE PREVIEW (Fluid FLIP Transition Link) -->
    <section class="monograph-next wrap" aria-labelledby="next-commission-heading">
      <header class="monograph-section-head">
        <div class="section-head__left">
          <span class="monograph-section-idx">04 / SEQUENTIAL STUDY</span>
          <h2 id="next-commission-heading" class="monograph-section-title">
            Next Architectural Commission Aperture
          </h2>
        </div>
        <div class="section-head__right">
          <a class="monograph-return-link draw" href="/works/">
            &larr; Return to All Works Directory
          </a>
        </div>
      </header>

      <a
        class="monograph-next__card"
        href={`/works/${nextCommission.slug}/`}
        data-transition="flip"
        data-gl-flip={nextCommission.slug}
        aria-label={`Advance to next architectural study: ${nextCommission.title}`}
      >
        <div class="next-card__media-stage">
          <div class="next-card__media-wrap" data-editorial-parallax>
            <Image
              class="project-photo next-card__img"
              src={nextCommission.image}
              alt={nextCommission.alt}
              width={nextCommission.image.width}
              height={nextCommission.image.height}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="next-card__lens-overlay" aria-hidden="true">
            <span class="lens-tag">NEXT APERTURE &middot; STUDY {nextStudyNum}</span>
            <span class="lens-crosshair">+</span>
          </div>
        </div>

        <div class="next-card__meta-bar">
          <div class="next-card__meta-left">
            <span class="next-kicker">
              Study {nextStudyNum} / {totalStudies} &middot; {nextCommission.typology} &middot; {nextCommission.location} &middot; {nextCommission.year}
            </span>
            <h3 class="next-title">{nextCommission.title}</h3>
            <p class="next-summary">{nextCommission.summary}</p>
          </div>

          <div class="next-card__meta-right">
            <div class="next-pill-row" aria-hidden="true">
              {nextCommission.materials.slice(0, 2).map((m) => (
                <span class="next-mat-pill">
                  <span class="mat-dot" style={`background-color: ${m.swatchHex};`}></span>
                  <span>{m.label.split(' ')[0]} {m.label.split(' ')[1] || ''}</span>
                </span>
              ))}
            </div>

            <div class="next-action-pill">
              <span>View Architectural Dossier</span>
              <span class="next-arrow" aria-hidden="true">&rarr;</span>
            </div>
          </div>
        </div>
      </a>
    </section>

  </div>
</Base>

<style>
  /* ==========================================================================
     ARCHITECTURAL MONOGRAPH STYLES (Inspired by 40_otto_objects & 06_unseen)
     Strict alignment with Rubiconius design tokens & typography hierarchy
     ========================================================================== */

  .monograph-page {
    position: relative;
    width: 100%;
    color: var(--c-fg);
    background-color: var(--c-bg);
    padding-bottom: clamp(5rem, 4rem + 4vw, 8rem);
  }

  /* --------------------------------------------------------------------------
     HEADER & DATUM BAR
     -------------------------------------------------------------------------- */
  .monograph-header {
    padding-top: clamp(2.5rem, 1.8rem + 2.5vw, 4.5rem);
    padding-bottom: clamp(1.75rem, 1.25rem + 1.5vw, 3rem);
  }

  .monograph-header__datum-bar {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem 1.5rem;
    padding: 1rem 0;
    margin-bottom: clamp(1.5rem, 1rem + 1.2vw, 2.5rem);
    border-top: 1px solid var(--c-line);
    border-bottom: 1px solid var(--c-line);
  }

  @media (min-width: 768px) {
    .monograph-header__datum-bar {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .datum-col {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .datum-tag {
    font-family: var(--f-body);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-subtle);
  }

  .datum-value {
    font-family: var(--f-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--c-fg);
  }

  .monograph-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--f-body);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--c-muted);
    margin-bottom: 1.25rem;
  }

  .monograph-breadcrumb a {
    color: var(--c-fg);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .monograph-breadcrumb a:hover {
    color: var(--c-bronze);
  }

  .monograph-breadcrumb .sep {
    color: var(--c-line);
  }

  .monograph-breadcrumb .current {
    color: var(--c-muted);
  }

  .monograph-title-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 1100px;
  }

  .monograph-kicker-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .monograph-tolerance-badge {
    font-family: var(--f-body);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--c-line);
    color: var(--c-bronze);
    background-color: var(--c-surface);
  }

  .monograph-hero__title {
    font-family: var(--f-display);
    font-size: var(--t-mega);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: var(--c-fg);
    margin: 0;
  }

  /* Millimeter CAD Tags */
  .monograph-cad-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin-top: 0.25rem;
    margin-bottom: 0.5rem;
  }

  .cad-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.7rem;
    background-color: var(--c-surface);
    border: 1px solid var(--c-line);
    font-family: var(--f-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--c-fg);
  }

  .cad-pill__dot {
    width: 5px;
    height: 5px;
    background-color: var(--c-bronze);
    border-radius: 50%;
  }

  .monograph-hero__lead {
    font-family: var(--f-body);
    font-size: clamp(1.0625rem, 0.98rem + 0.35vw, 1.25rem);
    line-height: 1.55;
    color: var(--c-muted);
    max-width: 820px;
    margin-top: 0.5rem;
  }

  /* --------------------------------------------------------------------------
     FULL BLEED HERO APERTURE & CAD STAMPS
     -------------------------------------------------------------------------- */
  .monograph-hero-stage {
    position: relative;
    width: 100%;
    margin-top: 1.5rem;
    margin-bottom: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .monograph-hero__plate {
    position: relative;
    width: 100%;
    margin: 0;
    overflow: hidden;
    background-color: var(--c-surface);
