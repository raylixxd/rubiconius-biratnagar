---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { commissions, site } from '../../data/site';

// Architectural Project Datums & Millimeter Metrics for Eastern Nepal Commissions
interface ProjectDatum {
  category: 'residence' | 'salon' | 'gallery';
  coords: string;
  elev: string;
  spanMm: {
    l: string;
    w: string;
    h: string;
  };
  envelopeMm: string;
  areaSqm: string;
  focusFeature: string;
  structuralDatum: string;
  tolerance: string;
  plateCode: string;
}

const projectDatums: Record<string, ProjectDatum> = {
  'fluted-master-suite': {
    category: 'residence',
    coords: '26.4678° N · 87.2767° E',
    elev: '80 M AMSL',
    spanMm: { l: '8,450', w: '5,600', h: '3,200' },
    envelopeMm: '8,450 × 5,600 × 3,200 MM',
    areaSqm: '47.3 M²',
    focusFeature: 'Continuous Sal Fluted Canopy',
    structuralDatum: 'Sal Hardwood · 45mm Pitch / 12mm Shadow Gap',
    tolerance: '± 1.0 MM REVEAL',
    plateCode: 'PL-01-FS3',
  },
  'formal-drawing-room': {
    category: 'salon',
    coords: '26.8124° N · 87.2834° E',
    elev: '349 M AMSL',
    spanMm: { l: '12,800', w: '7,400', h: '3,450' },
    envelopeMm: '12,800 × 7,400 × 3,450 MM',
    areaSqm: '94.7 M²',
    focusFeature: 'Honed Marble Axis & Garden Glazing',
    structuralDatum: 'Book-Matched Marble · 1,200 × 600mm Slabs',
    tolerance: '± 0.8 MM INLAY',
    plateCode: 'PL-02-DR1',
  },
  'heritage-panelled-gallery': {
    category: 'gallery',
    coords: '26.4678° N · 87.2767° E',
    elev: '80 M AMSL',
    spanMm: { l: '9,200', w: '4,800', h: '3,100' },
    envelopeMm: '9,200 × 4,800 × 3,100 MM',
    areaSqm: '44.2 M²',
    focusFeature: 'Tongue-and-Groove Reveal & Staggered Sal Shelves',
    structuralDatum: 'Lime-Wash T&G · 120mm Pitch / Sal Cantilevers',
    tolerance: '± 1.2 MM ALIGN',
    plateCode: 'PL-03-HG2',
  },
};

const totalPlates = String(commissions.length).padStart(2, '0');

const categories = [
  { id: 'all', label: 'All Commissions', count: '03' },
  { id: 'residence', label: 'Private Residences', count: '01' },
  { id: 'salon', label: 'Formal Salons', count: '01' },
  { id: 'gallery', label: 'Heritage Galleries', count: '01' },
];
---

<Base
  title="Works · Architectural Archive"
  description={`Architectural monographs, millimeter-measured millwork, and interior room dossiers across ${site.city} by ${site.name}.`}
>
  <div class="works-root" data-works-root>
    <!-- Architectural Coordinate Hero & View Switcher (Telha Clarke + 40 Otto Objects) -->
    <section class="works-hero wrap" aria-label="Works Archive Introduction">
      <!-- Coordinate Datum Bar -->
      <div class="works-datum-bar" aria-hidden="true">
        <div class="works-datum-bar__left">
          <span class="otto-t12 works-datum-tag">PORTFOLIO &middot; {site.primaryCity.toUpperCase()} &middot; NEPAL</span>
          <span class="works-datum-sep">/</span>
          <span class="otto-t12 works-datum-coords">LAT 26.4678° N &middot; LON 87.2767° E</span>
        </div>
        <div class="works-datum-bar__right">
          <span class="otto-t12 works-datum-scale">CADENCE: 1:1 FIELD MEASUREMENT</span>
          <span class="works-datum-sep">/</span>
          <span class="otto-t12 works-datum-metric">METRIC ENVELOPE: MM</span>
        </div>
      </div>

      <!-- Main Title Header with otto-t120 Monumental Header -->
      <div class="works-hero__main">
        <div class="works-hero__title-row">
          <h1 class="works-hero__monumental-title otto-t120">
            Commissions
          </h1>
          <div class="works-switcher" role="group" aria-label="View mode toggle">
            <button
              type="button"
              class="works-switcher__btn is-active"
              data-works-view-btn="editorial"
              aria-pressed="true"
            >
              <span class="works-switcher__label">Editorial</span>
              <span class="works-switcher__count">(03)</span>
            </button>
            <span class="works-switcher__sep" aria-hidden="true">/</span>
            <button
              type="button"
              class="works-switcher__btn"
              data-works-view-btn="index"
              aria-pressed="false"
            >
              <span class="works-switcher__label">Index</span>
              <span class="works-switcher__count">(03)</span>
            </button>
          </div>
        </div>

        <div class="works-hero__editorial-sub">
          <p class="works-hero__lead">
            Guided by {site.founder}, each commission pairs honest solid timber joinery, honed stone mass, and calibrated evening daylight across {site.city}.
          </p>
          <div class="works-hero__stats-line">
            <span class="works-stat-item">
              <strong class="works-stat-num">03</strong>
              <span class="works-stat-label">Commissions</span>
            </span>
            <span class="works-stat-divider">&middot;</span>
            <span class="works-stat-item">
              <strong class="works-stat-num">186.2</strong>
              <span class="works-stat-label">M² Measured Area</span>
            </span>
            <span class="works-stat-divider">&middot;</span>
            <span class="works-stat-item">
              <strong class="works-stat-num">12</strong>
              <span class="works-stat-label">Material Formulations</span>
            </span>
            <span class="works-stat-divider">&middot;</span>
            <span class="works-stat-item">
              <strong class="works-stat-num">02</strong>
              <span class="works-stat-label">Studios ({site.offices.map(o => o.city).join(' & ')})</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Category Filter Tabs (Requirement 2: All Commissions, Private Residences, Formal Salons, Heritage Galleries) -->
      <nav class="works-filters" aria-label="Filter commissions by category">
        <div class="works-filters__list" role="tablist">
          {categories.map((cat, idx) => (
            <button
              type="button"
              class={`works-filter-tab ${idx === 0 ? 'is-active' : ''}`}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              data-category-tab={cat.id}
            >
              <span class="otto-t12 works-filter-tab__text">{cat.label}</span>
              <span class="works-filter-tab__badge">({cat.count})</span>
            </button>
          ))}
        </div>
        <div class="works-filters__datum otto-t12" aria-hidden="true">
          <span>SPECIMENS: SAL · LIMESTONE · MARBLE · BRASS</span>
        </div>
      </nav>
    </section>

    <!-- Works Stage: Dual View Architecture (Zero DOM Duplication) -->
    <div class="works-stage" data-works-stage>
      <!-- ===================================================================
           EDITORIAL MONOGRAPH VIEW (Asymmetric Multi-Aperture Composition)
           =================================================================== -->
      <section
        class="works-editorial wrap"
        data-works-panel="editorial"
        aria-label="Architectural Monograph Spreads"
      >
        {commissions.map((c, idx) => {
          const num = String(idx + 1).padStart(2, '0');
          const datum = projectDatums[c.slug] || {
            category: 'residence',
            coords: 'Eastern Nepal',
            elev: '80 M AMSL',
            spanMm: { l: '8,000', w: '5,000', h: '3,000' },
            envelopeMm: '8,000 × 5,000 × 3,000 MM',
            areaSqm: '40 M²',
            focusFeature: c.focus,
            structuralDatum: 'Custom Millwork',
            tolerance: '± 1.0 MM',
            plateCode: `PL-0${num}`,
          };
          const hasDedicatedDetail = Boolean(c.detailImage);
          const layoutVariant = idx === 0 ? 'lead-asymmetric' : idx === 1 ? 'monumental-wide' : 'reversed-asymmetric';

          return (
            <article
              class={`works-spread works-spread--${layoutVariant}`}
              data-works-spread
              data-commission-slug={c.slug}
              data-category={datum.category}
            >
              <!-- Hairline Architectural Datum Bar -->
              <header class="works-spread__bar">
                <div class="works-spread__bar-left">
                  <span class="works-spread__plate otto-t12">PLATE {num} / {totalPlates}</span>
                  <span class="works-spread__sep" aria-hidden="true">&middot;</span>
                  <span class="works-spread__code otto-t12">{datum.plateCode}</span>
                  <span class="works-spread__sep" aria-hidden="true">&middot;</span>
                  <span class="works-spread__meta-inline otto-t12">{c.typology}</span>
                </div>
                <div class="works-spread__bar-right">
                  <span class="works-spread__coords otto-t12">{datum.coords}</span>
                  <span class="works-spread__sep" aria-hidden="true">&middot;</span>
                  <span class="works-spread__span otto-t12">SPAN: {datum.envelopeMm}</span>
                  <span class="works-spread__sep" aria-hidden="true">&middot;</span>
                  <span class="works-spread__year otto-t12">{c.year}</span>
                </div>
              </header>

              <!-- Spread Variant 01: Lead Asymmetric (Span 8 + Span 4) -->
              {idx === 0 && (
                <div class="works-spread__grid">
                  <!-- Primary Aperture (Monumental Frame with Interactive Hover Plate Badge) -->
                  <div class="works-spread__primary-col works-spread__primary-col--left">
                    <a
                      class="works-spread__frame works-spread__frame--4x3 otto-collection__card"
                      href={`/works/${c.slug}/`}
                      data-transition="flip"
                      data-gl-flip={c.slug}
                      data-gl
                      aria-label={`View ${c.title} complete dossier`}
                    >
                      <div class="works-spread__parallax" data-editorial-parallax>
                        <Image
                          class="project-photo works-spread__img"
                          src={c.image}
                          alt={c.alt}
                          width={c.image.width}
                          height={c.image.height}
                          style={c.primaryObjectPosition ? `object-position: ${c.primaryObjectPosition};` : undefined}
                          loading="eager"
                          decoding="sync"
                          fetchpriority="high"
                        />
                      </div>

                      <!-- Otto Objects Interactive Sliding Hover Plate Badge -->
                      <div class="otto-collection__label" aria-hidden="true">
                        <span>
                          <span class="otto-collection__plate otto-t12">
                            DOSSIER {num} &middot; VIEW STUDY &middot; {datum.envelopeMm}
                          </span>
                        </span>
                        <span>
                          <span class="otto-collection__arrow">↗</span>
                        </span>
                      </div>

                      <!-- Subtle Hairline Metric Corner Datums -->
                      <div class="works-frame-overlay-datums" aria-hidden="true">
                        <span class="works-frame-datum-tl otto-t12">{c.title}</span>
                        <span class="works-frame-datum-br otto-t12">{datum.areaSqm} &middot; {datum.tolerance}</span>
                      </div>
                    </a>
                  </div>

                  <!-- Aside Column: Secondary Aperture + Material Spec Plate + Study Meta -->
                  <div class="works-spread__aside-col works-spread__aside-col--bottom">
                    <div class={`works-spread__detail-wrap ${hasDedicatedDetail ? '' : 'is-fallback-crop'}`}>
                      {hasDedicatedDetail && c.detailImage ? (
                        <a
                          class="works-spread__frame works-spread__frame--4x5 otto-collection__card"
                          href={`/works/${c.slug}/#specs`}
                          aria-label={`View ${c.title} joinery study detail`}
                        >
                          <Image
                            class="project-photo works-spread__img"
                            src={c.detailImage}
                            alt={`${c.title} joinery and craftsmanship detail`}
                            width={c.detailImage.width}
                            height={c.detailImage.height}
                            loading="lazy"
                            decoding="async"
                          />
                          <div class="otto-collection__label" aria-hidden="true">
                            <span>
                              <span class="otto-collection__plate otto-t12">
                                DETAIL &middot; TIMBER JOINERY AXIS
                              </span>
                            </span>
                            <span>
                              <span class="otto-collection__arrow">↗</span>
                            </span>
                          </div>
                        </a>
                      ) : null}

                      <!-- Architectural Specification Plate (House of Corto + Otto Objects) -->
                      <aside class="works-spec-plate" aria-label={`${c.title} material specification plate`}>
                        <div class="works-spec-plate__head">
                          <span class="otto-t12">Plate {num} &middot; Specimen Ledger</span>
                          <span class="otto-t12">{datum.coords}</span>
                        </div>
                        <div class="works-spec-plate__chips" aria-hidden="true">
                          {c.materials.map((m) => (
                            <div class="works-spec-plate__chip-col">
                              <span class="works-spec-plate__chip" style={`background-color: ${m.swatchHex};`} title={m.label}></span>
                              <span class="works-spec-plate__hex otto-t12">{m.swatchHex}</span>
                            </div>
                          ))}
                        </div>
                        <dl class="works-spec-plate__rows">
                          <div>
                            <dt class="otto-t12">Millimeter Span</dt>
                            <dd class="otto-t12">{datum.envelopeMm}</dd>
                          </div>
                          <div>
                            <dt class="otto-t12">Joinery Module</dt>
                            <dd class="otto-t12">{datum.structuralDatum}</dd>
                          </div>
                          <div>
                            <dt class="otto-t12">Tolerance</dt>
                            <dd class="otto-t12">{datum.tolerance}</dd>
                          </div>
                          <div>
                            <dt class="otto-t12">Typology</dt>
                            <dd class="otto-t12">{c.typology}</dd>
                          </div>
                        </dl>
                      </aside>
                    </div>

                    <!-- Study Card Editorial Meta -->
                    <div class="study-card-meta">
                      <span class="study-eyebrow otto-t12">Study {num} &middot; {c.typology} &middot; {c.location}</span>
                      <h2 class="study-title">
                        <a href={`/works/${c.slug}/`}>{c.title}</a>
                      </h2>
                      <p class="study-summary">{c.summary}</p>

                      <div class="study-materiality">
                        <span class="study-materiality__label otto-t12">Primary Materiality</span>
                        <ul class="study-materiality__list">
                          {c.materials.slice(0, 3).map((m) => (
                            <li>
                              <span class="material-swatch" style={`background-color: ${m.swatchHex};`} aria-hidden="true"></span>
                              <span>{m.label}</span>
                            </li>
                          ))}
                        </ul>
                      </div>

                      <a class="study-dossier-link" href={`/works/${c.slug}/`}>
                        <span class="otto-t12">Inspect Complete Dossier</span>
                        <span class="study-dossier-link__arrow" aria-hidden="true">&rarr;</span>
                      </a>
                    </div>
                  </div>
                </div>
              )}

              <!-- Spread Variant 02: Monumental Wide (Span 12 Cinematic Frame) -->
              {idx === 1 && (
                <div class="works-spread__wide">
                  <a
                    class="works-spread__frame works-spread__frame--16x9 otto-collection__card"
                    href={`/works/${c.slug}/`}
                    data-transition="flip"
                    data-gl-flip={c.slug}
                    data-gl
                    aria-label={`View ${c.title} complete dossier`}
                  >
                    <div class="works-spread__parallax" data-editorial-parallax>
                      <Image
                        class="project-photo works-spread__img"
                        src={c.image}
                        alt={c.alt}
                        width={c.image.width}
                        height={c.image.height}
                        loading="lazy"
                        decoding="async"
                      />
                    </div>

                    <!-- Otto Objects Interactive Sliding Hover Plate Badge -->
                    <div class="otto-collection__label" aria-hidden="true">
                      <span>
                        <span class="otto-collection__plate otto-t12">
                          DOSSIER {num} &middot; FORMAL SALON &middot; {datum.envelopeMm}
                        </span>
                      </span>
                      <span>
                        <span class="otto-collection__arrow">↗</span>
                      </span>
                    </div>

                    <div class="works-frame-overlay-datums" aria-hidden="true">
                      <span class="works-frame-datum-tl otto-t12">{c.title}</span>
                      <span class="works-frame-datum-br otto-t12">{datum.areaSqm} &middot; {datum.tolerance}</span>
                    </div>
                  </a>

                  <!-- Wide Caption & Secondary Aperture Split Bar -->
                  <div class="works-spread__caption-bar">
                    <div class="study-card-meta">
                      <span class="study-eyebrow otto-t12">Study {num} &middot; {c.typology} &middot; {c.location}</span>
                      <h2 class="study-title">
                        <a href={`/works/${c.slug}/`}>{c.title}</a>
                      </h2>
                      <p class="study-summary">{c.summary}</p>

                      <!-- Millimeter Spec Ledger for Salon -->
                      <dl class="works-spec-plate__rows" style="margin-top: 1rem; max-width: 440px;">
                        <div>
                          <dt class="otto-t12">Envelope Span</dt>
                          <dd class="otto-t12">{datum.envelopeMm}</dd>
                        </div>
                        <div>
                          <dt class="otto-t12">Stone Format</dt>
                          <dd class="otto-t12">{datum.structuralDatum}</dd>
                        </div>
                        <div>
                          <dt class="otto-t12">Window Line</dt>
                          <dd class="otto-t12">6,800 MM SLENDER PIVOTING PROFILE</dd>
                        </div>
                      </dl>
                    </div>

                    <div class="works-spread__caption-right">
                      {hasDedicatedDetail && c.detailImage && (
                        <a
                          class="works-spread__frame works-spread__frame--16x9 otto-collection__card"
                          href={`/works/${c.slug}/#gallery`}
                          style="max-width: 420px; aspect-ratio: 16 / 10;"
                          aria-label={`View ${c.title} dining gallery detail`}
                        >
                          <Image
                            class="project-photo works-spread__img"
                            src={c.detailImage}
                            alt={`${c.title} adjoining dining hall and custom sideboard`}
                            width={c.detailImage.width}
                            height={c.detailImage.height}
                            loading="lazy"
                            decoding="async"
                          />
                          <div class="otto-collection__label" aria-hidden="true">
                            <span>
                              <span class="otto-collection__plate otto-t12">
                                DETAIL &middot; DINING GALLERY
                              </span>
                            </span>
                            <span>
                              <span class="otto-collection__arrow">↗</span>
                            </span>
                          </div>
                        </a>
                      )}

                      <div class="study-materiality">
                        <span class="study-materiality__label otto-t12">Materiality Formulation</span>
                        <ul class="study-materiality__list">
                          {c.materials.map((m) => (
                            <li>
                              <span class="material-swatch" style={`background-color: ${m.swatchHex};`} aria-hidden="true"></span>
                              <span>{m.label}</span>
                            </li>
                          ))}
                        </ul>
                      </div>

                      <a class="study-dossier-link" href={`/works/${c.slug}/`}>
                        <span class="otto-t12">Inspect Complete Dossier</span>
                        <span class="study-dossier-link__arrow" aria-hidden="true">&rarr;</span>
                      </a>
                    </div>
                  </div>
                </div>
              )}

              <!-- Spread Variant 03: Reversed Asymmetric (Span 5 Aside + Span 7 Primary) -->
              {idx === 2 && (
                <div class="works-spread__grid works-spread__grid--reversed">
                  <!-- Aside Column: Meta + Detail + Spec Plate -->
                  <div class="works-spread__aside-col works-spread__aside-col--top">
                    <div class="study-card-meta">
                      <span class="study-eyebrow otto-t12">Study {num} &middot; {c.typology} &middot; {c.location}</span>
                      <h2 class="study-title">
                        <a href={`/works/${c.slug}/`}>{c.title}</a>
                      </h2>
                      <p class="study-summary">{c.summary}</p>

                      <div class="study-materiality">
                        <span class="study-materiality__label otto-t12">Materiality Formulation</span>
                        <ul class="study-materiality__list">
                          {c.materials.slice(0, 3).map((m) => (
                            <li>
                              <span class="material-swatch" style={`background-color: ${m.swatchHex};`} aria-hidden="true"></span>
                              <span>{m.label}</span>
                            </li>
                          ))}
                        </ul>
                      </div>

                      <a class="study-dossier-link" href={`/works/${c.slug}/`}>
                        <span class="otto-t12">Inspect Complete Dossier</span>
                        <span class="study-dossier-link__arrow" aria-hidden="true">&rarr;</span>
                      </a>
                    </div>

                    <div class={`works-spread__detail-wrap ${hasDedicatedDetail ? '' : 'is-fallback-crop'}`}>
                      {hasDedicatedDetail && c.detailImage ? (
                        <a
                          class="works-spread__frame works-spread__frame--4x5 otto-collection__card"
                          href={`/works/${c.slug}/#specs`}
                          aria-label={`View ${c.title} artisan styling vignette`}
                        >
                          <Image
                            class="project-photo works-spread__img"
                            src={c.detailImage}
                            alt={`${c.title} cane, brass and reed styling vignette`}
                            width={c.detailImage.width}
                            height={c.detailImage.height}
                            loading="lazy"
                            decoding="async"
                          />
                          <div class="otto-collection__label" aria-hidden="true">
                            <span>
                              <span class="otto-collection__plate otto-t12">
                                DETAIL &middot; CANE & BRASS VIGNETTE
                              </span>
                            </span>
                            <span>
                              <span class="otto-collection__arrow">↗</span>
                            </span>
                          </div>
                        </a>
                      ) : null}

                      <aside class="works-spec-plate" aria-label={`${c.title} material specification plate`}>
                        <div class="works-spec-plate__head">
                          <span class="otto-t12">Plate {num} &middot; Palette</span>
                          <span class="otto-t12">{c.location} &middot; {c.year}</span>
                        </div>
                        <div class="works-spec-plate__chips" aria-hidden="true">
                          {c.materials.map((m) => (
                            <div class="works-spec-plate__chip-col">
                              <span class="works-spec-plate__chip" style={`background-color: ${m.swatchHex};`} title={m.label}></span>
                              <span class="works-spec-plate__hex otto-t12">{m.swatchHex}</span>
                            </div>
                          ))}
                        </div>
                        <dl class="works-spec-plate__rows">
                          <div>
                            <dt class="otto-t12">Millimeter Span</dt>
                            <dd class="otto-t12">{datum.envelopeMm}</dd>
                          </div>
                          <div>
                            <dt class="otto-t12">Panelling Pitch</dt>
                            <dd class="otto-t12">{datum.structuralDatum}</dd>
                          </div>
                          <div>
                            <dt class="otto-t12">Shelf Cantilever</dt>
                            <dd class="otto-t12">2,400 MM STAGGERED SAL</dd>
                          </div>
                          <div>
                            <dt class="otto-t12">Tolerance</dt>
                            <dd class="otto-t12">{datum.tolerance}</dd>
                          </div>
                        </dl>
                      </aside>
                    </div>
                  </div>

                  <!-- Primary Aperture (Right Side) -->
                  <div class="works-spread__primary-col works-spread__primary-col--right">
                    <a
                      class="works-spread__frame works-spread__frame--4x3 otto-collection__card"
                      href={`/works/${c.slug}/`}
                      data-transition="flip"
                      data-gl-flip={c.slug}
                      data-gl
                      aria-label={`View ${c.title} complete dossier`}
                    >
                      <div class="works-spread__parallax" data-editorial-parallax>
                        <Image
                          class="project-photo works-spread__img"
                          src={c.image}
                          alt={c.alt}
                          width={c.image.width}
                          height={c.image.height}
                          loading="lazy"
                          decoding="async"
                        />
                      </div>

                      <div class="otto-collection__label" aria-hidden="true">
                        <span>
                          <span class="otto-collection__plate otto-t12">
