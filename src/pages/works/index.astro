  <!-- Interactive Category Filtering & Hover Plate Sync Script -->
  <script is:inline>
    (function () {
      function initWorksFilter() {
        var root = document.querySelector('[data-works-root]');
        if (!root) return;

        var filterTabs = Array.from(root.querySelectorAll('[data-category-tab]'));
        var spreads = Array.from(root.querySelectorAll('[data-works-spread]'));
        var indexRows = Array.from(root.querySelectorAll('[data-index-row]'));

        function applyFilter(category) {
          filterTabs.forEach(function (tab) {
            var active = tab.getAttribute('data-category-tab') === category;
            tab.classList.toggle('is-active', active);
            tab.setAttribute('aria-selected', active ? 'true' : 'false');
          });

          spreads.forEach(function (spread) {
            var spreadCat = spread.getAttribute('data-category');
            var show = category === 'all' || spreadCat === category;
            if (show) {
              spread.removeAttribute('hidden');
              spread.style.display = '';
            } else {
              spread.setAttribute('hidden', '');
              spread.style.display = 'none';
            }
          });

          indexRows.forEach(function (row) {
            var rowCat = row.getAttribute('data-category');
            var show = category === 'all' || rowCat === category;
            if (show) {
              row.removeAttribute('hidden');
              row.style.display = '';
            } else {
              row.setAttribute('hidden', '');
              row.style.display = 'none';
            }
          });

          // Trigger ScrollTrigger & scroll layout recalculation if GSAP is loaded
          if (window.ScrollTrigger) {
            window.ScrollTrigger.refresh();
          }
        }

        filterTabs.forEach(function (tab) {
          tab.addEventListener('click', function () {
            var category = tab.getAttribute('data-category-tab') || 'all';
            applyFilter(category);
          });
        });

        // Hover Plate Badge Card Interaction
        var cards = Array.from(root.querySelectorAll('.otto-collection__card'));
        cards.forEach(function (card) {
          card.addEventListener('mouseenter', function () {
            card.classList.add('is-hover');
          });
          card.addEventListener('mouseleave', function () {
            card.classList.remove('is-hover');
          });
          card.addEventListener('focus', function () {
            card.classList.add('is-hover');
          });
          card.addEventListener('blur', function () {
            card.classList.remove('is-hover');
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initWorksFilter);
      } else {
        initWorksFilter();
      }
      document.addEventListener('astro:page-load', initWorksFilter);
    })();
  </script>

